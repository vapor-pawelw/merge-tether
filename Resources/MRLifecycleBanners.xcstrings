    "mrLifecycleBannersHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show updates for accepted events, merged or closed merge requests, and Draft status changes. These banners do not require coding automation or automatic removal."
