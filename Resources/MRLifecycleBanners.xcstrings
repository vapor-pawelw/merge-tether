      }
    },
    "mrLifecycleBannersAutoRemoveHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full automation enables removal when selected. When off, finished merge requests stay on the board until Seen. Completion items and event banners work independently."
          }
        }
      }
    },
