    "seenHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this finished merge request from the managed board. Its history and GitLab drafts are preserved."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Usuń zakończony merge request z zarządzanej tablicy. Historia i szkice w GitLabie zostaną zachowane."}}
      }
    },
    "completionMerged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This merge request was merged."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Ten merge request został scalony."}}
      }
    },
    "completionClosed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This merge request was closed."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Ten merge request został zamknięty."}}
