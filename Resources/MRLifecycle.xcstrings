    },
    "completionSeenHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Acknowledge this completion and remove it from Inbox."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Potwierdź zakończenie i usuń wpis ze Skrzynki."}}
      }
    },
    "completionSettingsTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed merge requests"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zakończone merge requesty"}}
      }
    },
    "completionSettingsHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merged and closed merge requests leave the board automatically. Their updates always appear in Inbox and stay until marked Seen. Event banners work independently."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Scalone i zamknięte merge requesty automatycznie opuszczają tablicę. Aktualizacje pojawiają się w Skrzynce i pozostają do oznaczenia jako przeczytane. Banery zdarzeń działają niezależnie."}}
      }
    }
  },
  "version": "1.0"
