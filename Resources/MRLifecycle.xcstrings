    "seen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seen"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Oznacz jako przeczytane"}}
