    },
    "publication.filtersManual": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Automatic publication is off. Saved filters are inactive and will be available when you choose a filtered mode." } },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatyczna publikacja jest wyłączona. Zapisane filtry są nieaktywne i będą dostępne po wybraniu trybu z filtrowaniem."}} }
    },
    "publication.requireAI": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Require AI-assisted source comments" } },
        "pl": {"stringUnit": {"state": "translated", "value": "Wymagaj, aby komentarze źródłowe były wspomagane przez AI"}} }
    },
    "publication.aiCommentCriteria": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "AI comment assessment prompt" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Prompt do oceny komentarzy AI" } } }
    },
    "publication.aiCommentCriteriaHelp": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Edit the criteria used to assess whether a comment was written with AI. This affects both comment badges and which replies can be published automatically. Apply Changes saves your prompt. A blank prompt restores the default." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Zmień kryteria oceny, czy komentarz napisano z pomocą AI. Wpływają na oznaczenia komentarzy i kwalifikację odpowiedzi do automatycznej publikacji. Kliknij „Zastosuj zmiany”, aby zapisać prompt. Puste pole przywraca domyślną treść." } } }
    },
    "publication.restoreAICommentCriteria": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Restore Default Prompt" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Przywróć domyślny prompt" } } }
    },
    "publication.aiRequiredByMode": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "This mode uses AI reply trust. Choose Matching filters to configure the AI condition independently." } },
        "pl": {"stringUnit": {"state": "translated", "value": "Ten tryb uwzględnia zaufanie do autorów odpowiedzi AI. Wybierz „Pasujące do filtrów”, aby ustawić warunek AI niezależnie."}} }
    },
    "publication.noConditions": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "No conditions are selected. Automatic publication stays blocked until you add a condition or choose another mode." } },
        "pl": {"stringUnit": {"state": "translated", "value": "Nie wybrano warunków. Automatyczna publikacja pozostaje wstrzymana do czasu dodania warunku lub wybrania innego trybu."}} }
    },
    "publication.noConditionsShort": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "No conditions selected" } },
        "pl": {"stringUnit": {"state": "translated", "value": "Brak wybranych warunków"}} }
    },
