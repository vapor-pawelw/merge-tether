        "pl": {"stringUnit": {"state": "translated", "value": "Przywróć tylko dla tego ustawienia wartość domyślną z profilu %1$@"}}
      }
    },
    "publication.unrestricted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
