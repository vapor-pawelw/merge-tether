    "publication.sourceHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source conditions apply to every external comment since your last published reply. New findings without a source comment stay private when a source or AI condition is active."
          }
        }
      }
    },
