    "publication.lookupFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not verify this GitLab identity. Check the value and connection, then try again."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się zweryfikować tej tożsamości w GitLabie. Sprawdź wpis i połączenie, a potem spróbuj ponownie."}}
      }
    },
    "publication.unrestrictedShort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unrestricted"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Bez ograniczeń"}}
      }
    },
    "publication.aiOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI feedback only"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Tylko uwagi AI"}}
      }
    },
    "publication.chooseResetDefaults": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose defaults for this setting"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wybierz domyślną wartość tego ustawienia"}}
      }
    },
    "publication.chooseResetDefaultsHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a profile to reset only this setting. Other settings stay as configured."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wybierz profil, aby przywrócić domyślną wartość tylko tego ustawienia. Pozostałe ustawienia zostaną zachowane."}}
      }
    },
    "publication.onlyAiReplies": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically publish replies to likely AI-assisted comments"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatycznie publikuj odpowiedzi na komentarze prawdopodobnie wspomagane przez AI"}}
      }
    },
    "publication.aiRepliesHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reply to an unconfirmed AI assessment stays private and needs your attention. Use Reply (AI) to confirm and publish after checks, or It's human to keep the draft private."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Odpowiedź na komentarz z niepotwierdzoną oceną AI pozostaje prywatna i wymaga Twojej uwagi. Wybierz „Odpowiedz (AI)”, aby potwierdzić i opublikować po sprawdzeniu, albo „To człowiek”, aby zachować prywatny szkic."}}
      }
    },
    "publication.automaticAll": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically publish all comments"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatycznie publikuj wszystkie komentarze"}}
      }
    },
    "publication.automaticAllHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publish every eligible checked comment without confirmation, regardless of the filters below."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Publikuj każdy kwalifikujący się sprawdzony komentarz bez potwierdzenia, niezależnie od poniższych filtrów."}}
      }
    },
    "publication.filtersIgnored": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All eligible checked comments can publish automatically. Saved filters are inactive in this mode."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wszystkie kwalifikujące się sprawdzone komentarze mogą zostać opublikowane automatycznie. Zapisane filtry są w tym trybie nieaktywne."}}
      }
    },
    "publication.automationOnlyHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These settings apply only to automation. The manual Publish all action ignores these filters."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Te ustawienia dotyczą tylko automatyzacji. Ręczne działanie „Opublikuj wszystkie” pomija te filtry."}}
      }
    },
    "publication.filtered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matching filters"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Pasujące do filtrów"}}
      }
    },
    "publication.filteredHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically publish comments matching every selected filter. Other comments stay as private drafts."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatycznie publikuj komentarze pasujące do wszystkich wybranych filtrów. Pozostałe komentarze zachowaj jako prywatne szkice."}}
      }
    },
    "publication.filtersInactive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inactive"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nieaktywne"}}
      }
    },
    "publication.allowBotReplies": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Allow replies to bot accounts"}}, "pl": {"stringUnit": {"state": "translated", "value": "Zezwól na odpowiedzi na komentarze kont botów"}}}},
    "publication.botRepliesHelp": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "In conditional modes, accounts confirmed as bots by GitLab metadata or your local bot list can qualify through this separate permission. Their comments stay classified as Bot; no distinction between scripts and AI is needed. Repository and author filters still apply. Each incoming comment must qualify; a human follow-up can keep the reply private. All eligible comments already includes bot replies."}}, "pl": {"stringUnit": {"state": "translated", "value": "W trybach warunkowych konta potwierdzone jako boty przez metadane GitLaba lub lokalną listę botów mogą kwalifikować się dzięki temu odrębnemu uprawnieniu. Ich komentarze zachowują klasyfikację „Bot” niezależnie od udziału skryptów lub AI. Nadal obowiązują filtry repozytoriów i autorów. Każdy przychodzący komentarz musi się kwalifikować. Późniejszy komentarz człowieka może sprawić, że odpowiedź pozostanie prywatna. Tryb wszystkich kwalifikujących się komentarzy już obejmuje odpowiedzi do botów."}}}},
    "publication.botRepliesShort": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Bot replies"}}, "pl": {"stringUnit": {"state": "translated", "value": "Odpowiedzi do botów"}}}}
  }
}
