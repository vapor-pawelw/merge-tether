    "publication.advancedHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All active conditions must match. With no conditions, comments stay as private drafts."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wszystkie aktywne warunki muszą być spełnione. Bez warunków komentarze pozostają prywatnymi szkicami."}}
      }
    },
