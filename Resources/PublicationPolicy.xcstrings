  "strings": {
    "publication.filtersManual": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Automatic publication is off. Saved filters are inactive and will be available when you choose a filtered mode." } } }
    },
    "publication.requireAI": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Require AI-assisted source comments" } } }
    },
    "publication.aiRequiredByMode": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Replies to AI or bot feedback requires an AI assessment, or a verified bot account when bot replies are allowed. Choose Matching filters to configure the AI condition independently." } } }
    },
    "publication.noConditions": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "No conditions are selected. Automatic publication stays blocked until you add a condition or choose another mode." } } }
    },
    "publication.noConditionsShort": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "No conditions selected" } } }
