    "publication.sourceHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Author filters cover the latest comments from others, even after your own replies."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Filtry autorów obejmują najnowsze komentarze innych osób, także po Twoich odpowiedziach."}}
      }
    },
