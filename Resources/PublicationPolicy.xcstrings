      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose defaults for this setting"
          }
        }
      }
    },
    "publication.chooseResetDefaultsHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a profile to reset only this setting. Other settings stay as configured."
          }
        }
      }
    },
    "publication.onlyAiReplies": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically publish replies to likely AI-assisted comments"
          }
        }
      }
    },
    "publication.aiRepliesHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For non-bot accounts, assessment concerns how the comment was written, including AI assistance used by a person. Known bot accounts have a fixed Bot badge. The separate bot-reply permission lets them qualify without an AI assessment; existing AI-evidence conditions remain independent. Other likely manual or uncertain sources stay private."
          }
        }
      }
    },
    "publication.automaticAll": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically publish all comments"
          }
        }
      }
    },
    "publication.automaticAllHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publish every eligible checked comment without confirmation, regardless of the filters below."
          }
        }
      }
    },
    "publication.filtersIgnored": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All eligible checked comments can publish automatically. Saved filters are inactive in this mode."
          }
        }
      }
    },
    "publication.automationOnlyHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These settings apply only to automation. The manual Publish all action ignores these filters."
          }
        }
      }
    },
    "publication.filtered": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matching filters"
          }
        }
      }
    },
    "publication.filteredHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically publish comments matching every selected filter. Other comments stay as private drafts."
          }
        }
      }
    },
    "publication.filtersInactive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inactive"
          }
        }
      }
    },
    "publication.allowBotReplies": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Allow replies to bot accounts"}}}},
    "publication.botRepliesHelp": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "In conditional modes, accounts confirmed as bots by GitLab metadata or your local bot list can qualify through this separate permission. Their comments stay classified as Bot; no distinction between scripts and AI is needed. Repository and author filters still apply. Each incoming comment must qualify; a human follow-up can keep the reply private. All eligible comments already includes bot replies."}}}},
    "publication.botRepliesShort": {"extractionState": "manual", "localizations": {"en": {"stringUnit": {"state": "translated", "value": "Bot replies"}}}}
  }
}
