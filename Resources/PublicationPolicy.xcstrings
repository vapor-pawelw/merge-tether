{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "publication.otherReviewThreadReplies": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically publish corrections in other reviewers’ threads"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie publikuj sprostowania w cudzych wątkach"
          }
        }
      }
    },
    "publication.otherReviewThreadRepliesHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you review someone else’s merge request, MergeTether can publish a reply that corrects a material factual error in an open thread started by another participant. The selected publication mode and its filters still apply."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy przeglądasz cudzy merge request, MergeTether może opublikować sprostowanie istotnego błędu rzeczowego w otwartym wątku innego uczestnika. Nadal obowiązuje wybrany tryb publikacji i jego filtry."
          }
        }
      }
    },
    "publication.aiReplyTrustHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified or declared automation, generation footers, and comments you mark as AI qualify directly. Style assessments qualify when at least two comments from the author were confirmed as AI and at least two thirds of their recent labels are AI. We use the last 30 days when they contain at least two labels and the last 90 days otherwise."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zweryfikowana lub zadeklarowana automatyzacja, stopka o wygenerowaniu oraz komentarze oznaczone przez Ciebie jako AI kwalifikują się bezpośrednio. Ocena stylu kwalifikuje się, jeśli co najmniej dwa komentarze autora potwierdzono jako AI i stanowią one co najmniej dwie trzecie jego ostatnich oznaczeń. Przy co najmniej dwóch oznaczeniach liczymy ostatnie 30 dni, a przy mniejszej liczbie ostatnie 90 dni."
          }
        }
      }
    },
    "publication.aiReplyTrustAuthors": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Author trust for AI replies"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaufanie do autorów odpowiedzi AI"
          }
        }
      }
    },
    "publication.aiReplyTrustEmpty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No author decisions for this account."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak decyzji dotyczących autorów na tym koncie."
          }
        }
      }
    },
