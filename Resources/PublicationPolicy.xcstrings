          "stringUnit": {
            "state": "translated",
            "value": "Publication filters"
          }
        }
      }
    },
    "publication.advancedHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All selected conditions must match. Empty lists add no restriction. Conditions only narrow the publication mode; unmatched or uncertain comments stay as private drafts."
          }
        }
      }
    },
