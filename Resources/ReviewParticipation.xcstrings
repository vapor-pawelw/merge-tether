{
  "sourceLanguage": "en",
  "strings": {
    "reviewParticipationTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No automatic replies or review requests"
          }
        }
      }
    },
    "reviewParticipationUsername": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitLab username"
          }
        }
      }
    },
    "reviewParticipationExclude": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclude participant"
          }
        }
      }
    },
    "reviewParticipationAllow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow again"
          }
        }
      }
    },
    "reviewParticipationFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not verify this GitLab username. Check the account and try again."
          }
        }
      }
    },
    "reviewParticipationHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved immediately for the current GitLab account and host. Excluded participants receive no automatic replies, acknowledgements or review invitations. Their technical findings remain actionable. Explicit manual publication is separate. This does not remove existing reviewers or change automation permissions."
          }
        }
      }
    },
    "reviewParticipationSaveFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save this preference. The participant remains excluded in this session; automatic actions are on hold. Try again."
          }
        }
      }
    },
    "reviewParticipationAutomationTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot accounts"
          }
        }
      }
    },
    "reviewParticipationAutomationMark": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add bot account"
          }
        }
      }
    },
    "reviewParticipationAutomationRestore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use GitLab account type"
          }
        }
      }
    },
    "reviewParticipationAutomationOwnAccount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your signed-in account cannot be marked as an automation author."
          }
        }
      }
    },
    "reviewParticipationAutomationSaveFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save this designation. The previous list is unchanged; automatic actions are on hold. Try again."
          }
        }
      }
    },
    "reviewParticipationAutomationHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These accounts are treated as bots for this GitLab host and signed-in account. Verified, answered feedback can be resolved automatically when your automation settings allow it. Other review and merge requirements still apply. Removing an entry restores GitLab’s account type."
          }
        }
      }
    }
  },
  "version": "1.0"
}
