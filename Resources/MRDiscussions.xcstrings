    "mrDiscussions.feedbackHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback status comes from the current code and discussion assessment. Replies and GitLab resolution are shown separately."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Stan uwag wynika z oceny bieżącego kodu i dyskusji. Odpowiedzi i stan rozwiązania w GitLabie są pokazane osobno."}}
      }
    },
    "mrDiscussions.branches.%@.%@": {
