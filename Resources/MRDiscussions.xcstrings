    "mrDiscussions.aiLegend": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI means recorded app-generated content, a verified assistant or a high-confidence AI-assisted assessment. AI uncertain means an explicitly uncertain assessment. Human means likely manual writing with high confidence, not proven authorship. A thread badge summarizes all published posts; system events and private drafts are excluded. Mixed AI/Human threads or missing current assessments have no thread badge. Badges do not grant publication permission. Bot identifies comments from a known bot or automation account, without deciding whether scripts or AI produced them. Bot classification is fixed by GitLab metadata or your local bot list and cannot be changed in the origin menu."
          }
        }
      }
    },
    "mrDiscussions.aiVerified": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified agent identity. The badge does not approve the comment or change publication permissions."
          }
        }
      }
    },
    "mrDiscussions.aiAppGenerated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Created with AI in MergeTether. A recorded app run produced this exact draft, and its publication was matched to this exact comment and account. Changing the comment text invalidates this display evidence. This does not approve its content or grant publication permission."
          }
        }
      }
    },
    "mrDiscussions.aiMergeTether": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
