    "mrDiscussions.ai": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI"
          }
        }
      }
    },
    "mrDiscussions.aiLegend": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI means recorded app-generated content, a verified assistant or a high-confidence AI-assisted assessment. AI uncertain means an explicitly uncertain assessment. Human means likely manual writing with high confidence, not proven authorship. A thread badge summarizes all published posts; system events and private drafts are excluded. Mixed AI/Human threads or missing current assessments have no thread badge. Badges do not grant publication permission."
          }
        }
      }
    },
    "mrDiscussions.aiVerified": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified agent identity. The badge does not approve the comment or change publication permissions."
          }
        }
      }
    },
    "mrDiscussions.aiAppGenerated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Created with AI in MergeTether. A recorded app run produced this exact draft, and its publication was matched to this exact comment and account. Changing the comment text invalidates this display evidence. This does not approve its content or grant publication permission."
          }
        }
      }
    },
    "mrDiscussions.aiAssessed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assessed as written with AI assistance with high or very high confidence for this exact comment. This does not approve its content or independently allow publication."
          }
        }
      }
    },
    "mrDiscussions.aiUncertain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI uncertain"
          }
        }
      }
    },
    "mrDiscussions.human": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Human"
          }
        }
      }
    },
    "mrDiscussions.aiUncertainHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assessment has insufficient or mixed evidence, or uncertain confidence, for this exact comment. This is not a confirmed AI origin and does not qualify it for AI-only automatic publication."
          }
        }
      }
    },
    "mrDiscussions.humanHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assessed as likely written manually with high or very high confidence for this exact comment. This is a probabilistic judgment, not proof of human authorship, and does not qualify it for AI-only automatic publication."
          }
        }
      }
    },
    "mrDiscussions.threadAiHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every published post and reply has recorded app-generation evidence, a verified assistant identity or a current high-confidence AI-assisted assessment. System events and private drafts are excluded. This does not approve the thread or change publication permissions."
          }
        }
      }
    },
    "mrDiscussions.threadUncertainHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every published post has recorded app-generation evidence, a current assessment or a verified assistant identity, at least one assessment is explicitly uncertain, and none is confidently assessed as manual. The thread is not confirmed as entirely AI-assisted. System events and private drafts are excluded."
          }
        }
      }
    },
    "mrDiscussions.threadHumanHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every published post and reply is assessed as likely written manually with high or very high confidence. This is not proof of human authorship. System events and private drafts are excluded."
          }
        }
      }
    },
