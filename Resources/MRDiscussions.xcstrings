      }
    },
    "mrDiscussions.manualHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You set this classification. It replaces the automatic assessment, including for automatic publication, until the comment is edited."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Ta klasyfikacja zastępuje automatyczną ocenę, także na potrzeby automatycznej publikacji, do czasu edycji komentarza."}}
      }
    },
    "mrDiscussions.originCancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Anuluj"}}
      }
    },
    "mrDiscussions.originChangeFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t change the classification"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się zmienić klasyfikacji"}}
      }
    },
    "mrDiscussions.originChangeFailedMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The comment may have changed on GitLab, or the classification couldn’t be saved. Refresh the conversation and try again."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Komentarz mógł się zmienić w GitLabie albo zapis klasyfikacji się nie powiódł. Odśwież rozmowę i spróbuj ponownie."}}
      }
    },
    "mrDiscussions.originResume.%lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This change lets automation publish %lld draft reply."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This change lets automation publish %lld draft replies."
                }
              }
            }
          }
        },
        "pl": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "Ta zmiana pozwala automatycznie opublikować %lld szkic odpowiedzi."}}, "few": {"stringUnit": {"state": "translated", "value": "Ta zmiana pozwala automatycznie opublikować %lld szkice odpowiedzi."}}, "many": {"stringUnit": {"state": "translated", "value": "Ta zmiana pozwala automatycznie opublikować %lld szkiców odpowiedzi."}}, "other": {"stringUnit": {"state": "translated", "value": "Ta zmiana pozwala automatycznie opublikować oczekujące szkice odpowiedzi (%lld)."}}}}}
      }
    },
    "mrDiscussions.originResumeCountdown.%lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automation continues in %lld s."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatyzacja zostanie wznowiona za %lld s."}}
      }
    },
