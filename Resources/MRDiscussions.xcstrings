    "mrDiscussions.noOwnReply": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No published reply from you"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Brak Twojej opublikowanej odpowiedzi"}}
      }
    },
    "mrDiscussions.noOwnReplyHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No published reply is attributed to the current account. The opening comment and system events do not count as replies. This is conversation history, not a request to take action."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Bieżącemu kontu nie przypisano opublikowanej odpowiedzi. Komentarz otwierający i zdarzenia systemowe są pomijane. To informacja o historii rozmowy."}}
      }
    },
    "mrDiscussions.publishedReply": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Published reply"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Opublikowana odpowiedź"}}
      }
    },
    "mrDiscussions.publishedReplyHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification confirms that your published reply answers all concerns requiring a reply. Later informational acknowledgements can follow it without changing this status. A pending draft takes priority and is shown instead."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Weryfikacja potwierdza, że opublikowana odpowiedź obejmuje wszystkie uwagi wymagające reakcji. Późniejsze komentarze informacyjne nie zmieniają tego stanu. Oczekujący szkic ma pierwszeństwo i jest wyświetlany zamiast odpowiedzi."}}
      }
    },
    "mrDiscussions.earlierReply": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Published reply · newer comments"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Opublikowana odpowiedź · nowsze komentarze"}}
      }
    },
    "mrDiscussions.earlierReplyHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current account replied earlier. Newer comments follow that reply, so it does not indicate a response to the latest comment. Private drafts are shown separately."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Bieżące konto odpowiedziało wcześniej. Po odpowiedzi pojawiły się nowsze komentarze. Prywatne szkice są pokazane osobno."}}
      }
    },
    "mrDiscussions.replyUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reply attribution unclear"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Autor odpowiedzi niepewny"}}
      }
    },
    "mrDiscussions.replyUnknownHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one reply has no known username, so a reply from the current account cannot be confirmed or ruled out."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Co najmniej jedna odpowiedź ma nieznaną nazwę użytkownika. Nie można ustalić, czy bieżące konto odpowiedziało."}}
      }
    },
    "mrDiscussions.replyUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reply status unavailable"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Stan odpowiedzi niedostępny"}}
      }
    },
    "mrDiscussions.replyUnavailableHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current account username is unavailable, so published replies cannot be attributed. Private drafts are shown separately."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nazwa użytkownika bieżącego konta jest niedostępna, więc nie można przypisać opublikowanych odpowiedzi. Prywatne szkice są pokazane osobno."}}
      }
    },
