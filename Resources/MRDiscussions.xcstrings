    "mrDiscussions.aiLegend": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An AI badge means a verified agent identity or a high-confidence assessment that this comment was written with AI assistance. A person’s comment can qualify. No badge does not mean it was written manually."
          }
        }
      }
    },
