        },
        "pl": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "Ta zmiana pozwala automatycznie opublikować %lld szkic odpowiedzi."}}, "few": {"stringUnit": {"state": "translated", "value": "Ta zmiana pozwala automatycznie opublikować %lld szkice odpowiedzi."}}, "many": {"stringUnit": {"state": "translated", "value": "Ta zmiana pozwala automatycznie opublikować %lld szkiców odpowiedzi."}}, "other": {"stringUnit": {"state": "translated", "value": "Ta zmiana pozwala automatycznie opublikować oczekujące szkice odpowiedzi (%lld)."}}}}}
      }
    },
