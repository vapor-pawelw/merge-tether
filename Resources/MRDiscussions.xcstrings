    "mrDiscussions.extraContextHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MergeTether's explanation for you. It stays in the app and is never posted to GitLab."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wyjaśnienie MergeTether, dostępne tylko dla Ciebie w aplikacji."}}
      }
    },
    "mrDiscussions.botOriginHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Known bot or automation account, confirmed by GitLab metadata or your local bot list. Its comments are classified as Bot without distinguishing scripts from AI. This classification follows the account and cannot be changed here. Automatic bot replies require their separate publication permission."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Znane konto bota lub automatyzacji, potwierdzone przez metadane GitLaba lub lokalną listę botów. Jego komentarze mają etykietę „Bot” niezależnie od tego, czy powstały przez skrypt czy AI. Klasyfikacja wynika z konta i jest stała w tym menu. Automatyczne odpowiedzi do botów wymagają osobnego uprawnienia do publikacji."}}
      }
    },
    "mrDiscussions.feedbackAddressedHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All requested concerns have been handled through verified corrections in the current remote merge-request code or metadata, substantive answers, or justified decisions not to implement a suggestion. Required published replies and GitLab thread resolution are shown separately."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wszystkie zgłoszone uwagi zostały obsłużone poprzez zweryfikowane poprawki w bieżącym zdalnym kodzie lub metadanych MR, merytoryczne odpowiedzi lub uzasadnione decyzje o pominięciu sugestii. Wymagane opublikowane odpowiedzi i stan rozwiązania dyskusji w GitLabie są pokazane osobno."}}
      }
    }
  },
  "version": "1.0"
}
