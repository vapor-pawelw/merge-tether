    "mrDiscussions.ai": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI"
          }
        }
      }
    },
    "mrDiscussions.aiLegend": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An AI badge means a verified agent identity or a high-confidence assessment that this comment was written with AI assistance. A person’s comment can qualify. No badge does not mean it was written manually."
          }
        }
      }
    },
    "mrDiscussions.aiVerified": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified agent identity. The badge does not approve the comment or change publication permissions."
          }
        }
      }
    },
    "mrDiscussions.aiAssessed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assessed as written with AI assistance with high or very high confidence for this exact comment. This does not approve its content or independently allow publication."
          }
        }
      }
    },
