    "mrDiscussions.ai": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "AI"}}
      }
    },
    "mrDiscussions.aiLegend": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI means recorded app-generated content, a verified assistant or a high-confidence AI-assisted assessment. AI uncertain means an explicitly uncertain assessment. Human means likely manual writing with high confidence, not proven authorship. A thread badge summarizes all published posts; system events and private drafts are excluded. Mixed AI/Human threads or missing current assessments have no thread badge. Badges do not grant publication permission. Bot identifies comments from a known bot or automation account, without deciding whether scripts or AI produced them. Bot classification is fixed by GitLab metadata or your local bot list and cannot be changed in the origin menu."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Etykieta „AI” oznacza treść utworzoną przez aplikację, zweryfikowanego asystenta lub wysoką pewność, że tekst powstał przy wsparciu AI. „AI niepewne” oznacza niejednoznaczną ocenę. „Człowiek” oznacza wysoką pewność, że tekst napisano ręcznie. Etykieta dyskusji obejmuje wszystkie opublikowane wypowiedzi z pominięciem zdarzeń systemowych i prywatnych szkiców. Dyskusje mieszane i dyskusje bez aktualnych ocen pozostają bez etykiety. Etykiety nie przyznają uprawnień do publikacji. „Bot” oznacza znane konto bota lub automatyzacji, niezależnie od tego, czy tekst powstał przez skrypt czy AI. Klasyfikacja bota wynika z metadanych GitLaba lub lokalnej listy botów i jest stała w tym menu."}}
      }
    },
    "mrDiscussions.aiVerified": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified agent identity. The badge does not approve the comment or change publication permissions."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zweryfikowana tożsamość asystenta. Etykieta służy wyłącznie do oznaczenia pochodzenia komentarza."}}
      }
    },
    "mrDiscussions.aiAppGenerated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Created with AI in MergeTether. A recorded app run produced this exact draft, and its publication was matched to this exact comment and account. Changing the comment text invalidates this display evidence. This does not approve its content or grant publication permission."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Utworzono z pomocą AI w MergeTether. Zarejestrowane zadanie utworzyło dokładnie ten szkic, a jego publikację powiązano z tym komentarzem i kontem. Edycja komentarza unieważnia to powiązanie. Zatwierdzenie treści i uprawnienia do publikacji podlegają odrębnym zasadom."}}
      }
    },
    "mrDiscussions.aiMergeTether": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI · MergeTether"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "AI · MergeTether"}}
      }
    },
    "mrDiscussions.aiAssessed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assessed as written with AI assistance with high or very high confidence for this exact comment. This does not approve its content or independently allow publication."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Dokładnie ten komentarz uznano z wysoką lub bardzo wysoką pewnością za napisany przy wsparciu AI. Ocena nie zatwierdza treści ani samodzielnie nie zezwala na publikację."}}
      }
    },
    "mrDiscussions.aiUncertain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI uncertain"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "AI niepewne"}}
      }
    },
    "mrDiscussions.human": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Human"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Człowiek"}}
      }
    },
    "mrDiscussions.aiUncertainHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assessment has insufficient or mixed evidence, or uncertain confidence, for this exact comment. This is not a confirmed AI origin and does not qualify it for AI-only automatic publication."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Dane o pochodzeniu tego komentarza są niewystarczające lub niejednoznaczne. Komentarz wymaga dalszej weryfikacji, aby kwalifikował się do automatycznej publikacji ograniczonej do AI."}}
      }
    },
    "mrDiscussions.humanHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assessed as likely written manually with high or very high confidence for this exact comment. This is a probabilistic judgment, not proof of human authorship, and does not qualify it for AI-only automatic publication."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Dokładnie ten komentarz uznano z wysoką lub bardzo wysoką pewnością za napisany ręcznie. Ocena jest probabilistyczna, a komentarz nie kwalifikuje się do automatycznej publikacji ograniczonej do AI."}}
      }
    },
    "mrDiscussions.threadAiHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every published post and reply comes from a known bot account or has recorded app-generation evidence, a verified assistant identity or a current high-confidence AI-assisted assessment. System events and private drafts are excluded. This does not approve the thread or change publication permissions."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Każda opublikowana wypowiedź pochodzi od znanego bota lub ma potwierdzenie utworzenia przez aplikację, zweryfikowaną tożsamość asystenta albo aktualną ocenę wskazującą z wysoką pewnością na udział AI. Pominięto zdarzenia systemowe i prywatne szkice. Zatwierdzenie i publikacja podlegają odrębnym zasadom."}}
      }
    },
    "mrDiscussions.threadUncertainHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every published post has recorded app-generation evidence, a current assessment or a verified assistant identity, at least one assessment is explicitly uncertain, and none is confidently assessed as manual. The thread is not confirmed as entirely AI-assisted. System events and private drafts are excluded."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Każda opublikowana wypowiedź ma potwierdzenie utworzenia przez aplikację, aktualną ocenę lub zweryfikowaną tożsamość asystenta. Co najmniej jedna ocena jest niejednoznaczna, a żadna nie wskazuje z wysoką pewnością na ręczne autorstwo. Udziału AI w całej dyskusji nie potwierdzono. Pominięto zdarzenia systemowe i prywatne szkice."}}
      }
    },
    "mrDiscussions.threadHumanHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every published post and reply is assessed as likely written manually with high or very high confidence. This is not proof of human authorship. System events and private drafts are excluded."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Każdą opublikowaną wypowiedź uznano z wysoką lub bardzo wysoką pewnością za napisaną ręcznie. To ocena prawdopodobieństwa autorstwa. Pominięto zdarzenia systemowe i prywatne szkice."}}
      }
    },
