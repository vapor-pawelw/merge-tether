    "mrDiscussions.aiLegend": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes means the comment is assessed as AI-assisted. No means it is assessed as likely written manually. Uncertain records an inconclusive assessment. An empty selection means no assessment is available. Use automatic assessment restores the automatic result. Bot identifies the account."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Tak oznacza ocenę wskazującą na udział AI. Nie oznacza, że komentarz prawdopodobnie napisano ręcznie. Niepewne oznacza niejednoznaczną ocenę. Brak zaznaczenia oznacza brak oceny. Użyj automatycznej oceny przywraca wynik automatyczny. Etykieta Bot dotyczy konta."}}
      }
    },
    "mrDiscussions.aiVerified": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified agent identity. The badge does not approve the comment or change publication permissions."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zweryfikowana tożsamość asystenta. Etykieta służy wyłącznie do oznaczenia pochodzenia komentarza."}}
      }
    },
    "mrDiscussions.aiAssessed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assessed as written with AI assistance with high or very high confidence for this exact comment. This does not approve its content or independently allow publication."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Dokładnie ten komentarz uznano z wysoką lub bardzo wysoką pewnością za napisany przy wsparciu AI. Ocena nie zatwierdza treści ani samodzielnie nie zezwala na publikację."}}
      }
    },
    "mrDiscussions.aiUncertainHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assessment has insufficient or mixed evidence, or uncertain confidence, for this exact comment. This is not a confirmed AI origin and does not qualify it for AI-only automatic publication."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Dane o pochodzeniu tego komentarza są niewystarczające lub niejednoznaczne. Komentarz wymaga dalszej weryfikacji, aby kwalifikował się do automatycznej publikacji ograniczonej do AI."}}
      }
    },
    "mrDiscussions.humanHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assessed as likely written manually with high or very high confidence for this exact comment. This is a probabilistic judgment, not proof of human authorship, and does not qualify it for AI-only automatic publication."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Dokładnie ten komentarz uznano z wysoką lub bardzo wysoką pewnością za napisany ręcznie. Ocena jest probabilistyczna, a komentarz nie kwalifikuje się do automatycznej publikacji ograniczonej do AI."}}
      }
    },
    "mrDiscussions.draftCount.%lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld private draft"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld private drafts"
                }
              }
            }
          }
