    "mrDiscussions.threadOriginMessage.%lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This changes %lld published comment. Private drafts have no classification and stay as they are."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "This changes all %lld published comments. Private drafts have no classification and stay as they are."
                }
              }
            }
          }
        },
        "pl": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "Klasyfikacja %lld opublikowanego komentarza zostanie zmieniona. Prywatne szkice pozostaną bez klasyfikacji."}}, "few": {"stringUnit": {"state": "translated", "value": "Klasyfikacja wszystkich %lld opublikowanych komentarzy zostanie zmieniona. Prywatne szkice pozostaną bez klasyfikacji."}}, "many": {"stringUnit": {"state": "translated", "value": "Klasyfikacja wszystkich %lld opublikowanych komentarzy zostanie zmieniona. Prywatne szkice pozostaną bez klasyfikacji."}}, "other": {"stringUnit": {"state": "translated", "value": "Wszystkie opublikowane komentarze (%lld) zmienią klasyfikację. Prywatne szkice pozostaną bez klasyfikacji."}}}}}
      }
    },
