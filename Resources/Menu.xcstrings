      }
    },
    "menu.scope.pauseDraftsHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to Default. Always on/off overrides this default and keeps your choice when the merge request becomes ready. This setting never marks an MR ready, and Draft merge requests never merge automatically."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Dotyczy opcji „Domyślne”. Opcje „Zawsze włączone” i „Zawsze wyłączone” mają pierwszeństwo i obowiązują także po oznaczeniu MR jako gotowego. Oznaczenie gotowości wymaga osobnego działania. Scalanie szkiców odbywa się ręcznie."}}
      }
    },
    "menuScopeSourceDraft": {
      "extractionState": "manual",
