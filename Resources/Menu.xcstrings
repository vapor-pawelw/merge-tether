        "pl": {"stringUnit": {"state": "translated", "value": "Automatyzacja tego merge requesta jest włączona. Kliknij, aby zobaczyć szczegóły i reguły. Kliknij z klawiszem Option, aby wstrzymać."}}
      }
    },
