{
  "sourceLanguage": "en",
  "strings": {
    "menu.scope.draftConfirmationRepositoryMessage.%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This enables automation for MRs in %@ that follow the repository default, including existing and future Draft MRs. Enabled rules may start agent reviews, feedback fixes, pipeline or conflict work. Your current permissions also control pushes, comment publication, approvals and discussion resolution.\n\nExplicit Always on/off choices, global action permissions and filters still apply. MRs stay Draft and cannot merge automatically until Ready."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Włącza automatyzację dla MR w %@, które dziedziczą ustawienie repozytorium, w tym obecnych i przyszłych MR w trybie szkicu. Włączone reguły mogą uruchamiać przeglądy, poprawki po uwagach oraz zadania związane z pipeline’ami lub konfliktami. Bieżące uprawnienia określają także możliwość wysyłania zmian, publikowania komentarzy, zatwierdzania i zamykania dyskusji.\n\nNadal obowiązują indywidualne ustawienia „Zawsze włączone” i „Zawsze wyłączone”, uprawnienia globalne i filtry. MR zachowują status szkicu, a automatyczne scalanie jest dostępne po oznaczeniu ich jako gotowe."}}
      }
    },
    "menu.scope.draftConfirmationAutoMessage.%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automation will resume for %@ while it is Draft. Enabled rules may start agent reviews, feedback fixes, pipeline or conflict work. Your current permissions also control pushes, comment publication, approvals and discussion resolution.\n\nThis MR returns to Default and follows repository and global defaults, including future changes to the Draft pause. Global action permissions and filters still apply. The MR stays Draft and cannot merge automatically until Ready."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatyzacja zostanie wznowiona dla %@ jeszcze w trybie szkicu. Włączone reguły mogą uruchamiać przeglądy, poprawki po uwagach oraz zadania związane z pipeline’ami lub konfliktami. Bieżące uprawnienia określają także możliwość wysyłania zmian, publikowania komentarzy, zatwierdzania i zamykania dyskusji.\n\nMR wraca do opcji „Domyślne” i stosuje ustawienia repozytorium oraz globalne, w tym przyszłe zmiany wstrzymywania dla szkiców. Globalne uprawnienia i filtry nadal obowiązują. MR zachowuje status szkicu, a automatyczne scalanie jest dostępne po oznaczeniu go jako gotowego."}}
      }
    },
    "menu.scope.draftConfirmationTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable automation while Draft?"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Włączyć automatyzację w trybie szkicu?"}}
      }
    },
    "menu.scope.draftConfirmationEnable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable automation"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Włącz automatyzację"}}
      }
    },
    "menu.scope.draftConfirmationMessage.%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automation will be enabled for %@ while it is Draft. Enabled rules may start agent reviews, feedback fixes, pipeline or conflict work. Your current permissions also control pushes, comment publication, approvals and discussion resolution.\n\nThis sets Always on for this MR and keeps that choice when it becomes Ready. Global action permissions and filters still apply. The MR stays Draft and cannot merge automatically until Ready."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatyzacja zostanie włączona dla %@ jeszcze w trybie szkicu. Włączone reguły mogą uruchamiać przeglądy, poprawki po uwagach oraz zadania związane z pipeline’ami lub konfliktami. Bieżące uprawnienia określają także możliwość wysyłania zmian, publikowania komentarzy, zatwierdzania i zamykania dyskusji.\n\nUstawia opcję „Zawsze włączone” dla tego MR i zachowuje ją po oznaczeniu go jako gotowego. Nadal obowiązują globalne uprawnienia i filtry. MR zachowuje status szkicu, a automatyczne scalanie jest dostępne po oznaczeniu go jako gotowego."}}
      }
    },
    "menu.scope.draftConfirmationGlobalMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft merge requests in your automation scope will follow the same enabled rules as Ready MRs. This may start agent reviews, feedback fixes, pipeline or conflict work. Your current permissions also control pushes, comment publication, approvals and discussion resolution.\n\nThis applies to existing and future drafts in Default. Explicit Always on/off choices, global action permissions and filters still apply. MRs stay Draft and cannot merge automatically until Ready."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wersje robocze merge requestów w Twoim zakresie będą podlegać tym samym włączonym regułom co MR gotowe do przeglądu. Może to uruchomić przeglądy, poprawki po uwagach oraz zadania związane z pipeline’ami lub konfliktami. Bieżące uprawnienia określają także możliwość wysyłania zmian, publikowania komentarzy, zatwierdzania i zamykania dyskusji.\n\nDotyczy obecnych i przyszłych szkiców z opcją „Domyślne”. Nadal obowiązują indywidualne ustawienia „Zawsze włączone” i „Zawsze wyłączone”, uprawnienia globalne i filtry. MR zachowują status szkicu, a automatyczne scalanie jest dostępne po oznaczeniu ich jako gotowe."}}
      }
    },
    "menu.scope.enabledHelp.%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automation enabled. Uses your current Settings rules and permissions. Globally disabled actions stay off. Scope: %@."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatyzacja jest włączona i stosuje bieżące reguły oraz uprawnienia z ustawień. Działania wyłączone globalnie pozostają wyłączone. Zakres: %@."}}
      }
    },
    "menu.scope.pausedHelp.%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automation paused. General permissions are unchanged. Scope: %@."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatyzacja jest wstrzymana. Uprawnienia ogólne pozostają w mocy. Zakres: %@."}}
      }
    },
