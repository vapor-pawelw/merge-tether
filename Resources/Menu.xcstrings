    },
    "menu.workflow.blocker.rebase": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Rebase the source branch before merging."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Przed scaleniem wykonaj rebase gałęzi źródłowej."}}
      }
    },
    "menu.workflow.blocker.statusChecks": {
