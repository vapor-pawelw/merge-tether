    "crashReporting.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {"stringUnit" : {"state" : "translated", "value" : "Help the MergeTether maintainer diagnose crashes. If you opt in, MergeTether sends the crash time and type, app and system versions, MergeTether stack frames, and a random installation ID to Sentry. You can turn reporting off at any time in Settings."}},
        "pl" : {"stringUnit" : {"state" : "translated", "value" : "Pomóż twórcy MergeTether diagnozować awarie. Jeśli wyrazisz zgodę, MergeTether wyśle do Sentry czas i typ awarii, wersję aplikacji i systemu, fragment śladu stosu dotyczący MergeTether oraz losowy identyfikator instalacji. Raportowanie możesz w każdej chwili wyłączyć w ustawieniach."}}
      }
    },
    "crashReporting.enable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {"stringUnit" : {"state" : "translated", "value" : "Send crash reports"}},
