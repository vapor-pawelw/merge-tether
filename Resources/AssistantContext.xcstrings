    "assistant.context.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open the agent. Check that it is installed and try again."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się otworzyć agenta. Sprawdź, czy jest zainstalowany, i spróbuj ponownie."}}
