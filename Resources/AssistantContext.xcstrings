    "assistant.context.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a separate conversation with this MR’s link and title. Hold Option to choose another app."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Otwórz osobną rozmowę z linkiem i tytułem tego MR. Przytrzymaj Option, aby wybrać inną aplikację."}}
      }
    },
    "assistant.context.startIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start conversation in %@"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Rozpocznij rozmowę w %@"}}
      }
    },
    "assistant.context.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Anuluj"}}
      }
    },
    "assistant.context.chooseHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an app for this conversation only. Your default stays unchanged."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wybierz aplikację tylko dla tej rozmowy. Domyślny wybór pozostanie bez zmian."}}
      }
    },
    "assistant.context.default": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default app"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Domyślna aplikacja"}}
      }
    },
    "assistant.context.settingsTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MR conversations"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Rozmowy o MR"}}
      }
    },
    "assistant.context.settingsHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a separate conversation with the MR’s link and title. Hold Option when selecting the menu action to choose another app for one conversation."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Rozpocznij osobną rozmowę z linkiem i tytułem tego MR. Przytrzymaj Option podczas wybierania działania w menu, aby wybrać inną aplikację dla jednej rozmowy."}}
      }
    },
    "assistant.context.chooseOpen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open conversation"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Otwórz rozmowę"}}
      }
    },
    "assistant.context.messageTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What would you like to discuss?"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "O czym chcesz porozmawiać?"}}
      }
    },
    "assistant.context.messageHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The MR context below is included automatically. Write your own message to start the terminal conversation."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Poniższy kontekst MR zostanie dołączony automatycznie. Napisz własną wiadomość, aby rozpocząć rozmowę w terminalu."}}
      }
    }
  },
  "version": "1.0"
}
