        "pl": {"stringUnit": {"state": "translated", "value": "Otwieraj rozmowy w"}}
      }
    },
    "assistant.context.settingsTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversations with an agent about changes"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Rozmowy z agentem o zmianach"}}
      }
    },
    "assistant.context.settingsHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app opens when you choose Start conversation on a merge request card."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Ta aplikacja otworzy się po wybraniu „Rozpocznij rozmowę” na karcie ze zmianami."}}
      }
    },
    "assistant.context.chooseOpen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open conversation"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Otwórz rozmowę"}}
      }
    },
    "assistant.context.messageTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What would you like to discuss?"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "O czym chcesz porozmawiać?"}}
      }
    },
    "assistant.context.messageHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The MR link below is included automatically. Write your message to start the terminal conversation."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Poniższy link do MR zostanie dołączony automatycznie. Napisz wiadomość, aby rozpocząć rozmowę w terminalu."}}
      }
    }
