          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "OK"}}
      }
    },
    "assistant.context.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a separate conversation with this MR’s link. Hold Option to choose another app."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Otwórz osobną rozmowę z linkiem do tego MR. Przytrzymaj Option, aby wybrać inną aplikację."}}
      }
    },
    "assistant.context.startIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start conversation in %@"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Rozpocznij rozmowę w %@"}}
      }
    },
    "assistant.context.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Anuluj"}}
      }
    },
    "assistant.context.chooseHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an app for this conversation only. Your default stays unchanged."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wybierz aplikację tylko dla tej rozmowy. Domyślny wybór pozostanie bez zmian."}}
      }
    },
    "assistant.context.default": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
