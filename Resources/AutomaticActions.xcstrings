      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Auto-merge" } } }
    },
    "automaticActions.mergeOn": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "On" } } }
    },
    "automaticActions.mergeOff": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Off" } } }
    },
    "automaticActions.mergeHelp": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Default follows global auto-merge settings. On enables auto-merge for this MR. Off pauses it. Automation scope, public action permissions and merge checks still apply." } } }
    },
    "automaticActions.approval": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Approval: follow global rules" } } }
    },
    "automaticActions.inheritHelp": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Checked: follow global permissions and this MR’s automation scope. Unchecked: automatic action paused for this MR. Globally disabled actions stay off; manual actions remain available." } } }
    },
    "automaticActions.exceptionsHelp": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "This MR has automatic action overrides. Review Automation in the … menu." } } }
