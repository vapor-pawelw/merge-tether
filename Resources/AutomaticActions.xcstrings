{
  "sourceLanguage": "en",
  "strings": {
    "automaticActions.publication": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Comment publication" } },
        "pl": {"stringUnit": {"state": "translated", "value": "Publikacja komentarzy"}} }
    },
    "automaticActions.verifiedReplyAcknowledgement": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Thanks for flagging this. The issue is addressed in the current changes." } },
        "pl": {"stringUnit": {"state": "translated", "value": "Dziękuję za zgłoszenie. Problem został uwzględniony w bieżących zmianach."}} }
    },
    "automaticActions.merge": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Auto-merge" } },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatyczne scalanie"}} }
    },
    "automaticActions.on": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "On" } },
        "pl": {"stringUnit": {"state": "translated", "value": "Włączone"}} }
    },
    "automaticActions.off": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Off" } },
        "pl": {"stringUnit": {"state": "translated", "value": "Wyłączone"}} }
    },
    "automaticActions.mergeHelp": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Default follows Settings. On qualifies this MR for auto-merge. Merge checks and any readiness requirements in the active prompt still apply. Off disables auto-merge for this MR." } },
        "pl": {"stringUnit": {"state": "translated", "value": "Domyślne stosuje ustawienia globalne. Włączone kwalifikuje ten MR do auto merge’a. Nadal obowiązują warunki scalania i wymagania gotowości z aktywnego promptu. Wyłączone blokuje auto merge dla tego MR-a."}} }
    },
    "automaticActions.approval": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Auto-approval" } },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatyczne zatwierdzanie"}} }
    },
    "automaticActions.publicationHelp": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "If automatic publication is off in Settings, On allows eligible replies to AI feedback." } },
        "pl": {"stringUnit": {"state": "translated", "value": "Jeśli automatyczna publikacja jest wyłączona w ustawieniach, włączenie tutaj zezwala na publikację kwalifikujących się odpowiedzi na uwagi AI."}} }
    },
    "automaticActions.approvalHelp": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Default follows Settings. On qualifies this MR for auto-approval. The configured findings threshold and any readiness requirements in the active prompt still apply. Off disables auto-approval for this MR." } },
        "pl": {"stringUnit": {"state": "translated", "value": "Domyślne stosuje ustawienia globalne. Włączone kwalifikuje ten MR do auto approve. Nadal obowiązują ustawiony próg uwag i wymagania gotowości z aktywnego promptu. Wyłączone blokuje auto approve dla tego MR-a."}} }
    },
    "automaticActions.exceptionsHelp": {
      "extractionState": "manual",
      "localizations": { "en": { "stringUnit": { "state": "translated", "value": "This MR has automatic action overrides. Review Automation in the … menu." } },
        "pl": {"stringUnit": {"state": "translated", "value": "Ten MR ma własne ustawienia działań automatycznych. Sprawdź sekcję Automatyzacja w menu „…”."}} }
    }
  },
  "version": "1.0"
}
