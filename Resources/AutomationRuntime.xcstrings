    "runtime.jobUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This agent run is unavailable for retry. Start a new action from the merge request."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "To uruchomienie agenta nie może zostać ponowione. Rozpocznij nowe działanie z poziomu merge requesta."}}
