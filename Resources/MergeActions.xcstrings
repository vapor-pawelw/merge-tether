{
  "sourceLanguage": "en",
  "strings": {
    "mergeActions.mergeNow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge now"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Scal teraz"}}
      }
    },
    "mergeActions.enqueue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set to auto-merge"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Ustaw automatyczne scalanie"}}
      }
    },
    "mergeActions.queued": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queued for auto-merge"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "W kolejce do automatycznego scalenia"}}
      }
    },
    "mergeActions.inTrain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In merge train"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "W pociągu scalania"}}
      }
    },
    "mergeActions.uncertain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge outcome unconfirmed. Check GitLab before trying again."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wynik scalania niepotwierdzony. Sprawdź GitLaba przed ponowieniem."}}
      }
    },
    "mergeActions.changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge queue context changed. Review the queue in GitLab."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Kontekst kolejki scalania się zmienił. Sprawdź kolejkę w GitLabie."}}
      }
    },
    "mergeActions.checkGitLab": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check merge in GitLab"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Sprawdź scalanie w GitLabie"}}
      }
    },
    "mergeActions.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge capability could not be verified. Check GitLab."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się potwierdzić możliwości scalenia. Sprawdź GitLaba."}}
      }
    },
    "mergeActions.confirmMerge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit this merge request?"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Przekazać ten merge request do scalenia?"}}
      }
    },
    "mergeActions.confirmHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current source, target, dependencies, approvals and feedback will be checked again. GitLab controls queued merges after submission. New feedback or setting changes are detected on refresh; the app does not cancel or replace queued work."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Źródło, gałąź docelowa, zależności, zatwierdzenia i uwagi zostaną sprawdzone ponownie. Po przekazaniu kolejką scalania zarządza GitLab. Odświeżenie wykryje nowe uwagi i zmiany ustawień. Obsługa anulowania lub zastąpienia pozycji w kolejce należy do GitLaba."}}
      }
    },
    "mergeActions.resolveAll": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve addressed threads…"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zamknij dyskusje z obsłużonymi uwagami…"}}
      }
    },
    "mergeActions.resolveConfirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve checked threads"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zamknij sprawdzone dyskusje"}}
      }
    },
    "mergeActions.resolveTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve the verified threads?"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zamknąć zweryfikowane dyskusje?"}}
      }
    },
    "mergeActions.resolveHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the listed, freshly checked threads will be resolved. Unaddressed, uncertain and unanswered comments stay open. Pending replies will not be published."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zamknięte zostaną tylko wymienione, właśnie sprawdzone dyskusje. Uwagi wymagające zmian lub odpowiedzi i uwagi o niepewnym wyniku pozostaną otwarte. Oczekujące odpowiedzi pozostaną w szkicach."}}
      }
    },
    "mergeActions.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Anuluj"}}
      }
    },
    "mergeActions.blocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge is blocked. Refresh and review the current requirements."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Scalanie jest zablokowane. Odśwież dane i sprawdź aktualne wymagania."}}
      }
    },
    "mergeActions.resolveResult": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolved %lld of %lld checked threads. %lld still require attention."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zamknięto %lld z %lld sprawdzonych dyskusji. Nadal wymagają uwagi: %lld."}}
      }
    },
    "mergeActions.resolvePreview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld threads ready to resolve; %lld held for work, verification or replies."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Dyskusje gotowe do zamknięcia: %lld. Oczekujące na zmiany, weryfikację lub odpowiedź: %lld."}}
      }
    },
    "mergeActions.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The action could not be verified. Refresh and check GitLab."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się potwierdzić działania. Odśwież dane i sprawdź GitLaba."}}
      }
    },
    "mergeActions.checkThreads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check threads to resolve"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Sprawdź dyskusje do zamknięcia"}}
      }
    },
    "mergeActions.checked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Threads checked"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Sprawdzono dyskusje"}}
      }
    },
    "mergeActions.resolveReadyThreads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready to resolve:\n%@"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Gotowe do zamknięcia:\n%@"}}
      }
    },
    "mergeActions.resolveHeldThreads": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still require work, verification or replies:\n%@"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nadal wymagają zmiany, weryfikacji lub odpowiedzi:\n%@"}}
      }
    },
    "mergeActions.trainRebaseConflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge train blocked: GitLab could not rebase the commits onto the target branch."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Pociąg scalania jest zablokowany. GitLab nie mógł przenieść commitów na bieżący stan gałęzi docelowej."}}
      }
    },
    "mergeActions.trainEvidenceUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge train preparation could not be checked. Review the current train in GitLab."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się sprawdzić przygotowania pociągu scalania. Sprawdź bieżący stan w GitLabie."}}
      }
    },
    "mergeActions.contextChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge checks belong to a different MR version. Refresh to check the current source and target."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wyniki kontroli dotyczą innej wersji MR. Odśwież dane, aby sprawdzić bieżące źródło i gałąź docelową."}}
      }
    },
    "mergeActions.checking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge readiness has not been checked for this MR yet. Refresh from GitLab."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Gotowość do scalenia tego MR czeka na sprawdzenie. Odśwież dane z GitLaba."}}
      }
    },
    "mergeActions.feedback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback still needs work, publication or current verification before merging."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Przed scaleniem uwagi wymagają dalszej pracy, publikacji lub aktualnej weryfikacji."}}
      }
    },
    "mergeActions.pipelineHandoff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pipeline work still needs your attention before merging."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Obsługa pipeline’u wymaga Twojej uwagi przed scaleniem."}}
      }
    },
    "mergeActions.draft": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark this merge request ready before merging."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Przed scaleniem oznacz ten merge request jako gotowy."}}
      }
    },
    "mergeActions.commentReview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review unpublished comments and finish comment review before merging."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Przed scaleniem przejrzyj nieopublikowane komentarze i zakończ ich przegląd."}}
      }
    },
    "mergeActions.approvals": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required approvals are still missing."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nadal brakuje wymaganych zatwierdzeń."}}
      }
    },
    "mergeActions.changesRequested": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reviewer has requested changes."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Recenzent poprosił o zmiany."}}
      }
    },
    "mergeActions.automaticDiscussionPolicy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-merge requires GitLab to enforce resolved discussions."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatyczne scalanie wymaga, aby GitLab egzekwował zamknięcie dyskusji."}}
      }
    },
    "mergeActions.discussions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve the outstanding discussions before merging."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Przed scaleniem zamknij otwarte dyskusje."}}
      }
    },
    "mergeActions.dependencies": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required merge requests must merge first."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Najpierw trzeba scalić wymagane merge requesty."}}
      }
    },
    "mergeActions.stackTarget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review this merge request’s target branch before merging."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Przed scaleniem sprawdź gałąź docelową tego merge requesta."}}
      }
    },
    "mergeActions.dependencyEvidence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependencies and the target branch could not be verified. Refresh to check again."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się zweryfikować zależności i gałęzi docelowej. Odśwież dane i spróbuj ponownie."}}
      }
    },
    "mergeActions.conflicts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve the merge conflict before merging."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Przed scaleniem rozwiąż konflikt."}}
      }
    },
    "mergeActions.pipeline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pipeline must pass before this merge can proceed."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Scalanie wymaga pomyślnego pipeline’u."}}
      }
    },
    "mergeActions.permissions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitLab reports that you do not have permission to merge this request."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "GitLab zgłasza brak uprawnień do scalenia tego merge requesta."}}
      }
    },
    "mergeActions.evidenceUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge requirements could not be fully verified. Refresh or check GitLab."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wymagań do scalenia nie udało się w pełni sprawdzić. Odśwież dane lub sprawdź GitLaba."}}
      }
    },
    "mergeActions.feedbackChecking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking whether the current feedback is addressed before merging."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Sprawdzanie przed scaleniem, czy bieżące uwagi zostały obsłużone."}}
      }
    },
    "mergeActions.feedbackFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback verification failed. Recheck feedback before merging."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Weryfikacja uwag się nie powiodła. Sprawdź je ponownie przed scaleniem."}}
      }
    },
    "mergeActions.feedbackSourceChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback was checked for an earlier source commit. Refresh to verify the current changes."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Uwagi sprawdzono dla wcześniejszego commita źródłowego. Odśwież dane, aby zweryfikować bieżące zmiany."}}
      }
    },
    "mergeActions.feedbackDiscussionChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The conversation has changed since feedback was checked. Refresh to check the current comments."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Dyskusja zmieniła się od czasu weryfikacji. Odśwież dane, aby sprawdzić bieżące komentarze."}}
      }
    },
    "mergeActions.feedbackDescriptionChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The merge request’s title or description changed since feedback was checked. Refresh to verify its current requirements."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Tytuł lub opis merge requesta zmienił się od weryfikacji uwag. Odśwież dane, aby sprawdzić bieżące wymagania."}}
      }
    },
    "mergeActions.feedbackUnverified": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some feedback has no current verified outcome. Review it before merging."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Część uwag nie ma aktualnego, zweryfikowanego wyniku. Przejrzyj je przed scaleniem."}}
      }
    },
    "mergeActions.feedbackChanges": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified feedback still requires correction work before merging."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zweryfikowane uwagi nadal wymagają poprawek przed scaleniem."}}
      }
    },
    "mergeActions.feedbackVerificationNeeded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A specific feedback requirement still needs verification. Review the feedback for details."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Jedno z wymagań w uwagach nadal wymaga weryfikacji. Szczegóły znajdziesz w uwagach."}}
      }
    },
    "mergeActions.feedbackPublication": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The feedback check is waiting for unpublished comments. Review comments before merging."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Weryfikacja uwag czeka na nieopublikowane komentarze. Przejrzyj je przed scaleniem."}}
      }
    },
    "mergeActions.feedbackReply": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A required reply has not been published in its discussion. Review the feedback before merging."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Brakuje wymaganej opublikowanej odpowiedzi w dyskusji. Przejrzyj uwagi przed scaleniem."}}
      }
    },
    "mergeActions.feedbackCodeReview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A question raised during feedback verification still needs review before merging."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Pytanie zgłoszone przy weryfikacji uwag wymaga przeglądu przed scaleniem."}}
      }
    },
    "mergeActions.feedbackConversationUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current conversation has not been read. Refresh from GitLab before checking feedback."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Bieżąca dyskusja czeka na odczyt. Odśwież dane z GitLaba przed sprawdzeniem uwag."}}
      }
    },
    "mergeActions.feedbackChecksPaused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic feedback checks are off or paused for this MR. Review its discussions and current evidence."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatyczne sprawdzanie uwag dla tego MR jest wyłączone lub wstrzymane. Przejrzyj jego dyskusje i bieżące dane."}}
      }
    },
    "mergeActions.replySources": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Published replies are still required for %lld comments. Review the specific feedback below."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Komentarze wymagające opublikowanej odpowiedzi: %lld. Przejrzyj wskazane uwagi poniżej."}}
      }
    },
    "mergeActions.replySource": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open comment #%lld"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Otwórz komentarz nr %lld"}}
      }
    },
    "mergeActions.resolveScope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve addressed threads checks open, resolvable discussions. It does not prepare replies or satisfy separate comments awaiting an answer."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Działanie sprawdza otwarte dyskusje, które można zamknąć. Przygotowanie odpowiedzi i obsługa osobnych komentarzy wymagają odrębnych działań."}}
      }
    },
    "mergeActions.verifyBeforeSubmit.%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the current feedback needs verification, MergeTether sends the merge request diff, description, and discussions to %@ for a read-only check before submitting."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Jeśli bieżące uwagi wymagają weryfikacji, przed przekazaniem MR do scalenia MergeTether wyśle diff, opis i dyskusje do %@ w celu sprawdzenia tylko do odczytu."}}
      }
    }
  },
  "version": "1.0"
