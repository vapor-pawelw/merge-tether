          }
        }
      }
    },
    "mergeActions.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge capability could not be verified. Check GitLab."
          }
        }
      }
    },
    "mergeActions.confirmMerge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submit this merge request?"
          }
        }
      }
    },
    "mergeActions.confirmHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current source, target, dependencies, approvals and feedback will be checked again. GitLab controls queued merges after submission. New feedback or setting changes are detected on refresh; the app does not cancel or replace queued work."
          }
        }
      }
    },
    "mergeActions.resolveAll": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve addressed threads…"
          }
        }
      }
    },
    "mergeActions.resolveConfirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve checked threads"
          }
        }
      }
    },
    "mergeActions.resolveTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve the verified threads?"
          }
        }
      }
    },
    "mergeActions.resolveHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the listed, freshly checked threads will be resolved. Unaddressed, uncertain and unanswered comments stay open. Pending replies will not be published."
          }
        }
      }
    },
    "mergeActions.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
