{
  "sourceLanguage": "en",
  "strings": {
    "authorFeedback.setting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve addressed feedback after reviewer acceptance"
          }
        }
      }
    },
    "authorFeedback.settingHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On my merge requests, verify every outstanding expectation before closing a reviewer’s threads. Their current approval or an explicit acceptance comment is required. Approval alone never proves a fix is complete."
          }
        }
      }
    },
    "authorFeedback.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviewer feedback"
          }
        }
      }
    },
    "authorFeedback.checking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking reviewer expectations…"
          }
        }
      }
    },
    "authorFeedback.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not verify reviewer feedback. Retry or inspect the discussion in GitLab."
          }
        }
      }
    },
    "authorFeedback.waitingPublication.%lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Publish %lld pending reply before closing threads."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Publish %lld pending replies before closing threads."
                }
              }
            }
          }
        }
      }
    },
    "authorFeedback.waitingAcceptance.%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for %@ to approve or explicitly confirm the fix."
          }
        }
      }
    },
    "authorFeedback.needsChanges": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes or an explanation are still needed."
          }
        }
      }
    },
    "authorFeedback.needsVerification": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The available evidence does not confirm that this is addressed."
          }
        }
      }
    },
    "authorFeedback.disabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic thread resolution is off."
          }
        }
      }
    },
    "authorFeedback.ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified and accepted; ready to close the thread."
          }
        }
      }
    },
    "authorFeedback.recheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify feedback again"
          }
        }
      }
    },
    "authorFeedback.handle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handle remaining feedback"
          }
        }
      }
    },
    "authorFeedback.waitingChip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Awaiting reviewer"
          }
        }
      }
    },
    "authorFeedback.needsWorkChip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback needs attention"
          }
        }
      }
    },
    "authorFeedback.autoFollowUpOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic follow-up is off. Handle the feedback manually or enable it in Settings."
          }
        }
      }
    },
    "authorFeedback.replyNeeded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A published reply explaining the fix is still missing."
          }
        }
      }
    },
    "authorFeedback.pushOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow-up push is off. Proposed fixes stay in the agent result until you deliver them manually or enable push."
          }
        }
      }
    },
    "authorFeedback.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
