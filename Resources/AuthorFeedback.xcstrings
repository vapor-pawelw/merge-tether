{
  "sourceLanguage": "en",
  "strings": {
    "authorFeedback.waitingReviewersPrefix": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Awaiting confirmation from" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Oczekiwanie na potwierdzenie od" } }
      }
    },
    "authorFeedback.waitingAcceptancePrefix": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Awaiting approval or explicit confirmation of the fix from" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Oczekiwanie na akceptację lub wyraźne potwierdzenie poprawki od" } }
      }
    },
    "authorFeedback.waitingAcceptance": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Waiting for approval or explicit confirmation of the fix." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Oczekiwanie na akceptację lub wyraźne potwierdzenie poprawki." } }
      }
    },
    "authorFeedback.manualDecision": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual decision needed for this thread"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Ta dyskusja wymaga ręcznej decyzji"}}
      }
    },
    "authorFeedback.decisionContext": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Problem and context"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Problem i kontekst"}}
      }
    },
    "authorFeedback.decisionVerified": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What has been verified"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Co zweryfikowano"}}
      }
    },
    "authorFeedback.decisionMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Missing evidence"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Brakujące dane"}}
      }
    },
    "authorFeedback.decisionQuestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decision needed"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Potrzebna decyzja"}}
      }
    },
    "authorFeedback.decisionImpact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Effect on this merge request"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wpływ na ten merge request"}}
      }
    },
    "authorFeedback.setting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve addressed feedback after reviewer acceptance"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zamykaj dyskusje po uwzględnieniu uwag i akceptacji recenzenta"}}
      }
    },
    "authorFeedback.settingHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On my merge requests, verify every outstanding expectation before closing a reviewer’s threads. Their current approval or an explicit acceptance comment is required. Approval alone never proves a fix is complete."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "W moich merge requestach sprawdzaj wszystkie otwarte wymagania recenzenta przed zamknięciem jego dyskusji. Wymagane jest jego bieżące zatwierdzenie lub wyraźna akceptacja w komentarzu. Kompletność poprawki musi być zweryfikowana osobno."}}
      }
    },
    "authorFeedback.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reviewer feedback"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Uwagi recenzentów"}}
      }
    },
    "authorFeedback.checking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking reviewer expectations…"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Sprawdzanie oczekiwań recenzentów…"}}
      }
    },
    "authorFeedback.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not verify reviewer feedback. Retry or inspect the discussion in GitLab."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się zweryfikować uwag. Ponów próbę lub sprawdź dyskusję w GitLabie."}}
      }
    },
    "authorFeedback.waitingPublication.%lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Publish %lld pending reply before closing threads."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Publish %lld pending replies before closing threads."
                }
              }
            }
          }
        },
        "pl": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "Opublikuj %lld oczekującą odpowiedź przed zamknięciem dyskusji."}}, "few": {"stringUnit": {"state": "translated", "value": "Opublikuj %lld oczekujące odpowiedzi przed zamknięciem dyskusji."}}, "many": {"stringUnit": {"state": "translated", "value": "Opublikuj %lld oczekujących odpowiedzi przed zamknięciem dyskusji."}}, "other": {"stringUnit": {"state": "translated", "value": "Opublikuj oczekujące odpowiedzi (%lld) przed zamknięciem dyskusji."}}}}}
      }
    },
    "authorFeedback.needsChanges": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes or an explanation are still needed."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nadal potrzebne są zmiany lub wyjaśnienie."}}
      }
    },
    "authorFeedback.needsVerification": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The available evidence does not confirm that this is addressed."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Dostępne dane nie potwierdzają, że uwaga została obsłużona."}}
      }
    },
    "authorFeedback.disabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic thread resolution is off."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatyczne zamykanie dyskusji jest wyłączone."}}
      }
    },
    "authorFeedback.ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verified and accepted; ready to close the thread."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zweryfikowano i zaakceptowano. Dyskusję można zamknąć."}}
      }
    },
    "authorFeedback.recheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify feedback again"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zweryfikuj uwagi ponownie"}}
      }
    },
    "authorFeedback.handle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handle remaining feedback"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Obsłuż pozostałe uwagi"}}
      }
    },
    "authorFeedback.waitingChip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Awaiting reviewer"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Oczekiwanie na recenzenta"}}
      }
    },
    "authorFeedback.autoFollowUpOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic follow-up is off. Handle the feedback manually or enable it in Settings."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatyczna obsługa uwag jest wyłączona. Obsłuż je ręcznie lub włącz funkcję w ustawieniach."}}
      }
    },
    "authorFeedback.replyNeeded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A published reply explaining the fix is still missing."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nadal brakuje opublikowanej odpowiedzi wyjaśniającej poprawkę."}}
      }
    },
    "authorFeedback.pushOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow-up push is off. Proposed fixes stay in the agent result until you deliver them manually or enable push."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wysyłanie poprawek po uwagach jest wyłączone. Propozycje pozostają w wyniku zadania do czasu ręcznego dostarczenia albo włączenia wysyłania."}}
      }
    },
    "authorFeedback.codeReviewQuestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private code question for the reviewer"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Prywatne pytanie do recenzenta o kod"}}
      }
    },
    "authorFeedback.codeReviewContext": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Related discussion (context only)"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Powiązana dyskusja (tylko kontekst)"}}
      }
    },
    "authorFeedback.waitingSummary.%@.%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "%@ · %@"}}
      }
    },
    "authorFeedback.threadResolutionWait": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback addressed, waiting for thread resolution from"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwagi uwzględnione. Oczekiwanie na zamknięcie wątków przez"
          }
        }
      }
    },
    "authorFeedback.botAuthor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bot"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Bot"}}
      }
    },
    "authorFeedback.botAuthorHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This author account is identified as automated by GitLab or a local setting. This is separate from whether the message used AI."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "GitLab lub lokalne ustawienia identyfikują konto autora jako automatyczne. Udział AI w powstaniu wiadomości jest oceniany osobno."}}
      }
    },
    "authorFeedback.needsMoreApprovals.%lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Needs %lld more approval"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Needs %lld more approvals"
                }
              }
            }
          }
        },
        "pl": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "Brakuje %lld zatwierdzenia"}}, "few": {"stringUnit": {"state": "translated", "value": "Brakuje %lld zatwierdzeń"}}, "many": {"stringUnit": {"state": "translated", "value": "Brakuje %lld zatwierdzeń"}}, "other": {"stringUnit": {"state": "translated", "value": "Brakujące zatwierdzenia: %lld"}}}}}
      }
    }
  },
  "version": "1.0"
}
