        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification failed"
          }
        }
      }
    },
    "authorFeedback.verifyingChip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifying feedback"
          }
        }
      }
    },
    "authorFeedback.pendingRepliesChip": {
