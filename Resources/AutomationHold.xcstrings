{
  "sourceLanguage": "en",
  "strings": {
    "automation.hold.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why automation is waiting"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Dlaczego automatyzacja czeka"}}
      }
    },
    "automation.hold.packageDisabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistant automation is turned off in Settings."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatyzacja asystenta jest wyłączona w Ustawieniach."}}
      }
    },
    "automation.hold.ignored": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This merge request is excluded from automation."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Ten merge request jest wykluczony z automatyzacji."}}
      }
    },
    "automation.hold.closed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic follow-up only runs on open merge requests."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatyczna kontynuacja działa tylko dla otwartych merge requestów."}}
      }
    },
    "automation.hold.scopePaused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automation is paused or outside the enabled scope for this merge request."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatyzacja jest wstrzymana lub ten merge request znajduje się poza włączonym zakresem."}}
      }
    },
    "automation.hold.draftPaused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automation is paused while this merge request is Draft. Enable automation for this draft or mark it ready."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatyzacja jest wstrzymana, gdy ten merge request ma status Draft. Włącz automatyzację dla wersji roboczej lub oznacz ją jako gotową."}}
      }
    },
    "automation.hold.runnerUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow-up uses a shell runner. Choose the assistant runner in Settings."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Kontynuacja używa powłoki. Wybierz w Ustawieniach asystenta."}}
      }
    },
    "automation.hold.notConfigured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The follow-up title or prompt is empty. Complete the rule in Settings."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Tytuł lub prompt kontynuacji jest pusty. Uzupełnij regułę w Ustawieniach."}}
      }
    },
    "automation.hold.projectExcluded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Author feedback rule excludes this repository."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Reguła opinii autora wyklucza to repozytorium."}}
      }
    },
    "automation.hold.workflowExcluded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new-discussion workflow excludes this repository, target branch or labels."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Przepływ nowych dyskusji wyklucza to repozytorium, gałąź docelową lub etykiety."}}
      }
    },
    "automation.hold.ruleDisabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic handling of author feedback is off. Enable Author feedback or an assistant workflow for new discussions in Settings."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatyczna obsługa opinii autora jest wyłączona. Włącz ją lub przepływ asystenta dla nowych dyskusji w Ustawieniach."}}
      }
    },
    "automation.hold.assistantUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected assistant CLI is not ready. Check installation and sign-in in Settings."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wybrany interfejs CLI asystenta nie jest gotowy. Sprawdź instalację i logowanie w Ustawieniach."}}
      }
    },
    "automation.hold.retryRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous attempt stopped. Review its result and retry explicitly; stopped work is not automatically repeated."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Poprzednia próba została zatrzymana. Sprawdź jej wynik i ponów ją jawnie; zatrzymana praca nie jest powtarzana automatycznie."}}
      }
    },
    "automation.hold.readinessUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current Draft status could not be read. Refresh the merge request before automation can continue."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się odczytać bieżącego statusu Draft. Odśwież merge request przed wznowieniem automatyzacji."}}
      }
    },
    "automation.hold.loginRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected CLI needs sign-in. Use the sign-in banner above to restore access."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wybrany interfejs CLI wymaga logowania. Użyj powyższego banera, aby odzyskać dostęp."}}
      }
    },
    "automation.hold.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected CLI has reached its usage limit. Use the banner above to inspect the reset time or retry queued work."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wybrany interfejs CLI osiągnął limit użycia. Użyj powyższego banera, aby sprawdzić czas resetu lub ponowić zadania w kolejce."}}
      }
    }
  },
  "version": "1.0"
}
