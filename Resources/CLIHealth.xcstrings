{
  "sourceLanguage": "en",
  "strings": {
    "cli.health.loginTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ needs you to sign in again"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "%@ musi ponownie się zalogować"}}
      }
    },
    "cli.health.limitTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has reached its usage limit"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "%@ osiągnął limit użycia"}}
      }
    },
    "cli.health.loginHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work using this CLI is paused. Sign in in your terminal, then check access again. Completed work is kept."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Praca w tym CLI została wstrzymana. Zaloguj się w terminalu, a następnie ponownie sprawdź dostęp. Ukończona praca została zachowana."}}
      }
    },
    "cli.health.limitHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New work using this CLI is paused. After access is restored, retry queued work. Stopped runs still need an explicit retry."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nowa praca w tym CLI została wstrzymana. Po przywróceniu dostępu ponów oczekujące zadania. Zatrzymane uruchomienia wymagają jawnego ponowienia."}}
      }
    },
    "cli.health.reset": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset time reported by the CLI: %@"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Czas resetu podany przez CLI: %@"}}
      }
    },
    "cli.health.limitCheckScheduled": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Work is paused. MergeTether will check access again at %@ and resume eligible work when access returns."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Praca jest wstrzymana. MergeTether sprawdzi dostęp ponownie o %@ i po jego przywróceniu wznowi zadania spełniające warunki."}}
      }
    },
    "cli.health.limitChecksStopped": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Three hourly checks could not confirm that access was restored. Automatic checks have stopped. Retry queued work manually when you have access."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Trzy sprawdzenia w odstępach godzinnych nie potwierdziły przywrócenia dostępu. Automatyczne sprawdzanie zostało zakończone. Po odzyskaniu dostępu ponów oczekujące zadania ręcznie."}}
      }
    },
    "cli.health.limitStillUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The CLI check could not confirm access. Try again once access is restored."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Sprawdzenie CLI nie potwierdziło dostępu. Spróbuj ponownie po odzyskaniu dostępu."}}
      }
    },
    "cli.health.signIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in…"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zaloguj się…"}}
      }
    },
    "cli.health.recheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check access"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Sprawdź dostęp"}}
      }
    },
    "cli.health.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry queued work"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Ponów oczekujące zadania"}}
      }
    },
    "cli.health.actionFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access is still unavailable. Finish signing in or check the CLI in Settings."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Dostęp nadal jest niedostępny. Dokończ logowanie lub sprawdź CLI w Ustawieniach."}}
      }
    }
  },
  "version": "1.0"
}
