          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Skonfiguruj automatyzację"}}
      }
    },
    "onboarding.auth.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you haven’t signed in, run this command in Terminal, then choose Re-check."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Jeśli logowanie jest jeszcze przed Tobą, uruchom to polecenie w Terminalu, a następnie wybierz „Sprawdź ponownie”."}}
      }
    },
