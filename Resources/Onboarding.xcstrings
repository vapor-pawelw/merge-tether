  "strings" : {
    "onboarding.automation.alreadyConfigured" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your automation settings are already configured. You can change them from Settings."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatyzacja jest już skonfigurowana. Możesz ją zmienić w ustawieniach."}}
      }
    },
    "onboarding.automation.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose whether MergeTether should automate MR work through a signed-in Codex or Claude CLI. You can also continue with manual actions only."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wybierz, czy MergeTether ma automatyzować pracę nad merge requestami przez zalogowane Codex CLI lub Claude CLI. Możesz też korzystać wyłącznie z ręcznych działań."}}
      }
    },
    "onboarding.automation.title" : {
      "extractionState" : "manual",
      "localizations" : {
