    "onboarding.install.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MergeTether uses glab, the GitLab CLI, to manage merge requests and read your to-dos. Install it with Homebrew, then choose Re-check."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "MergeTether używa glab, narzędzia wiersza poleceń GitLaba, do zarządzania merge requestami i odczytywania zadań. Zainstaluj je przez Homebrew i wybierz „Sprawdź ponownie”."}}
      }
    },
