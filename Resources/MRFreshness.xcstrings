{
  "sourceLanguage": "en",
  "strings": {
    "mr.freshness.accountChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The GitLab account changed. Refresh the MR and check GitLab sign-in."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Konto GitLaba się zmieniło. Odśwież MR i sprawdź logowanie."}}
      }
    },
    "mr.freshness.inactive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This merge request is no longer open. Refresh its GitLab status."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Ten merge request nie jest już otwarty. Odśwież jego stan w GitLabie."}}
      }
    },
    "mr.freshness.pipelinePassed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pipeline %lld already passed. Its previous failure no longer needs another run."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Pipeline %lld zakończył się już pomyślnie. Jego poprzedni błąd nie wymaga ponowienia."}}
      }
    },
    "mr.freshness.pipelineState": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pipeline %lld is now %@. Refresh the MR to see its current status."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Pipeline %lld ma teraz stan „%@”. Odśwież MR, aby zobaczyć jego bieżący stan."}}
      }
    },
    "mr.freshness.pipelineSuperseded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A newer pipeline replaced pipeline %lld. Refresh the MR to see its current status."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nowszy pipeline zastąpił pipeline %lld. Odśwież MR, aby zobaczyć jego bieżący stan."}}
      }
    },
    "mr.freshness.refresh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh from GitLab"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Odśwież z GitLaba"}}
      }
    },
    "mr.freshness.startFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not start this run: %@"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się uruchomić zadania: %@"}}
      }
    },
    "mr.freshness.staleHead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The MR changed before this action could start. Refresh its GitLab status."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "MR się zmienił przed rozpoczęciem działania. Odśwież jego stan w GitLabie."}}
      }
    },
    "mr.freshness.historicalRun": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This run is historical. Current GitLab status no longer requires retrying its pipeline failure."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "To zadanie historyczne. Bieżący stan GitLaba nie wymaga ponawiania obsługi jego błędu pipeline’u."}}
      }
    }
  },
  "version": "1.0"
}
