  "strings": {
    "commentReview.delete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete draft"
          }
        }
      }
    },
    "commentReview.deleteTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this draft from GitLab?"
          }
        }
      }
    },
    "commentReview.deleteHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This comment will not be published. Deleting drafts keeps the workflow paused until you finish reviewing comments."
          }
        }
      }
    },
    "commentReview.finish": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish comment review"
          }
        }
      }
    },
    "commentReview.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish reviewing comments to let the workflow continue."
          }
        }
      }
    },
    "commentReview.publishAll": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publish all and continue"
          }
        }
      }
    },
    "commentReview.publishSelectedHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publishes the selected comments. The workflow can continue when no drafts remain; other readiness checks still apply."
          }
        }
      }
    },
    "commentReview.deleting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
