{
  "sourceLanguage": "en",
  "strings": {
    "commentReview.replyAI": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reply (AI)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedz (AI)"
          }
        }
      }
    },
    "commentReview.markHuman": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's human"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To człowiek"
          }
        }
      }
    },
    "commentReview.unconfirmedAI.%@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Possible AI comment by %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komentarz od %@ mógł powstać z pomocą AI"
          }
        }
      }
    },
    "commentReview.aiDraftStillPrivate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI origin confirmed. The reply is still private."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierdzono udział AI. Odpowiedź pozostaje prywatna."
          }
        }
      }
    },
    "commentReview.aiReplyChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The draft or its source changed. Refresh and review it again."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szkic lub komentarz źródłowy się zmienił. Odśwież i sprawdź ponownie."
          }
        }
      }
    },
    "commentReview.aiReplyUncertain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI origin confirmed. Check GitLab for the publication result."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierdzono udział AI. Sprawdź wynik publikacji w GitLabie."
          }
        }
      }
    },
    "commentReview.delete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete draft"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Usuń szkic"}}
      }
    },
    "commentReview.deleteTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this draft from GitLab?"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Usunąć ten szkic z GitLaba?"}}
      }
    },
    "commentReview.deleteHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This comment will not be published. Deleting drafts keeps the workflow paused until you finish reviewing comments."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Komentarz pozostanie nieopublikowany. Usunięcie szkiców nie wznawia procesu. Najpierw zakończ przegląd komentarzy."}}
      }
    },
    "commentReview.finish": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish comment review"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zakończ przegląd komentarzy"}}
      }
    },
    "commentReview.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish reviewing comments to let the workflow continue."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zakończ przegląd komentarzy, aby wznowić proces."}}
      }
    },
    "commentReview.publishAll": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publish all and continue"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Opublikuj wszystkie i kontynuuj"}}
      }
    },
    "commentReview.reviewBeforePublishing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review before publishing"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Przejrzyj przed publikacją"}}
      }
    },
    "commentReview.publishSelectedHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publishes the selected comments. The workflow can continue when no drafts remain; other readiness checks still apply."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Publikuje zaznaczone komentarze. Proces może być kontynuowany, gdy nie będzie szkiców i przejdą pozostałe kontrole gotowości."}}
      }
    },
    "commentReview.deleting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting draft\u2026"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Usuwanie szkicu…"}}
      }
    },
    "commentReview.finishing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking comments\u2026"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Sprawdzanie komentarzy…"}}
      }
    },
    "commentReview.blocks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment review is blocking the next steps"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Przegląd komentarzy wstrzymuje kolejne kroki"}}
      }
    },
    "commentReview.beforeReReview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next: request another review after comment review is finished and the feedback is ready."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Następnie poproś o ponowny przegląd po zakończeniu przeglądu komentarzy i przygotowaniu odpowiedzi na uwagi."}}
      }
    },
    "commentReview.beforeMerge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next: merge after comment review is finished and all merge requirements are met."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Następnie scal MR po zakończeniu przeglądu komentarzy i spełnieniu wszystkich wymagań scalania."}}
      }
    },
    "commentReview.beforeApproval": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next: approve after comment review is finished, the current review has no objections, and the required discussions are resolved."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Następnie zatwierdź MR po zakończeniu przeglądu komentarzy, jeśli bieżący przegląd nie ma zastrzeżeń i wymagane dyskusje są zamknięte."}}
      }
    },
    "commentReview.otherChecks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New comments, commits and pipeline problems can still be handled. The workflow continues after the remaining readiness checks pass."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nadal możesz obsługiwać nowe komentarze, commity i problemy z pipeline’em. Proces będzie kontynuowany po pomyślnej weryfikacji pozostałych warunków."}}
      }
    },
    "commentReview.afterOwn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment review \u2192 re-review readiness \u2192 merge checks"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Przegląd komentarzy → gotowość do ponownego przeglądu → kontrole scalania"}}
      }
    },
    "commentReview.afterReviewed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment review \u2192 review verdict and discussion checks \u2192 approval"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Przegląd komentarzy → wynik przeglądu i kontrola dyskusji → zatwierdzenie"}}
      }
    },
    "commentReview.publishSelected.%lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Publish %lld comment and continue"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Publish %lld comments and continue"
                }
              }
            }
          }
        },
        "pl": {"variations": {"plural": {"one": {"stringUnit": {"state": "translated", "value": "Opublikuj %lld komentarz i kontynuuj"}}, "few": {"stringUnit": {"state": "translated", "value": "Opublikuj %lld komentarze i kontynuuj"}}, "many": {"stringUnit": {"state": "translated", "value": "Opublikuj %lld komentarzy i kontynuuj"}}, "other": {"stringUnit": {"state": "translated", "value": "Opublikuj komentarze (%lld) i kontynuuj"}}}}}
      }
    },
    "commentReview.step.commentReview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment review"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Przegląd komentarzy"}}
      }
    },
    "commentReview.step.reReviewReadiness": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-review readiness"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Gotowość do ponownego przeglądu"}}
      }
    },
    "commentReview.step.mergeChecks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge checks"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Kontrole scalania"}}
      }
    },
    "commentReview.step.reviewVerdict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review verdict and discussion checks"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wynik przeglądu i kontrola dyskusji"}}
      }
    },
    "commentReview.step.approval": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approval"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zatwierdzenie"}}
      }
    },
    "commentReview.stepsHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automation order for this merge request. The highlighted step is the current one."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Kolejność automatyzacji tego merge requesta. Wyróżniono bieżący krok."}}
      }
    }
  },
  "version": "1.0"
}
