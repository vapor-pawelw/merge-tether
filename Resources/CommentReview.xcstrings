        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking comments\u2026"
          }
        }
      }
    },
    "commentReview.blocks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment review is blocking the next steps"
          }
        }
      }
    },
    "commentReview.beforeReReview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next: request another review after comment review is finished and the feedback is ready."
          }
        }
      }
    },
