      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next: merge after comment review is finished and all merge requirements are met."
          }
        }
      }
    },
    "commentReview.beforeApproval": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next: approve after comment review is finished, the current review has no objections, and the required discussions are resolved."
          }
        }
      }
    },
    "commentReview.otherChecks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New comments, commits and pipeline problems can still be handled. The workflow continues after the remaining readiness checks pass."
          }
        }
      }
    },
