          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Użytkownik GitLaba nr %lld"}}
      }
    },
    "feedbackSuggestions.threadOpenedBy": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Thread opened by" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Autor wątku:" } }
      }
    },
    "feedbackSuggestions.ignore": {
      "extractionState": "manual",
      "localizations": {
