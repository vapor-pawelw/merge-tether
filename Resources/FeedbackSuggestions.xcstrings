        },
        "pl": {"stringUnit": {"state": "translated", "value": "Dokładna wersja komentarza jest niedostępna lub nie odpowiada bieżącej weryfikacji. Odśwież dyskusje, aby wczytać aktualny kontekst."}}
      }
    },
