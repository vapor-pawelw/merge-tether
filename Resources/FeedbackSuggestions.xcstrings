        },
        "pl": {"stringUnit": {"state": "translated", "value": "Pominąć tę sugestię?"}}
      }
    },
    "feedbackSuggestions.ignoreConfirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore suggestion"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Pomiń sugestię"}}
      }
    },
    "feedbackSuggestions.ignoreExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This ignores only the displayed suggestion for this version of the source comment. Other requirements in the comment still apply. No GitLab discussion will be resolved. You can restore the suggestion in Details → Ignored suggestions."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Pominięcie dotyczy tylko wyświetlonej sugestii w tej wersji komentarza. Pozostałe wymagania z komentarza nadal obowiązują. Dyskusje GitLaba zachowają swój stan. Sugestię możesz przywrócić w sekcji Szczegóły → Pominięte sugestie."}}
      }
    },
    "feedbackSuggestions.concern": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggestion"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Sugestia"}}
      }
    },
    "feedbackSuggestions.comment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source comment"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Komentarz źródłowy"}}
      }
    },
    "feedbackSuggestions.ignored": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignored suggestions"
