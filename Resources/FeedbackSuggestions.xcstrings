      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Przywróć"}}
      }
    },
    "feedbackSuggestions.reset": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset all decisions for this MR"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zresetuj wszystkie decyzje dla tego MR"}}
      }
    },
    "feedbackSuggestions.resetTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset all decisions for this MR?"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zresetować wszystkie decyzje dla tego MR?"}}
      }
    },
    "feedbackSuggestions.resetExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore all ignored suggestions for this MR and request a fresh assessment. GitLab discussions and saved task history remain unchanged."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Przywróć wszystkie pominięte sugestie dla tego MR i zleć nową ocenę. Dyskusje GitLaba i zapisana historia zadań zostaną zachowane."}}
      }
    },
    "feedbackSuggestions.resetConfirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset decisions"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zresetuj decyzje"}}
      }
    },
    "feedbackSuggestions.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Anuluj"}}
      }
    },
    "feedbackSuggestions.updateFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not update this decision. Try refreshing the MR."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się zaktualizować decyzji. Spróbuj odświeżyć MR."}}
      }
    },
    "feedbackSuggestions.sourceChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source comment changed. Review its current version before ignoring this suggestion."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Komentarz źródłowy się zmienił. Sprawdź jego bieżącą wersję przed pominięciem sugestii."}}
      }
    },
    "feedbackSuggestions.accountChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your GitLab account changed. Reopen this MR before updating its decisions."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Twoje konto GitLaba się zmieniło. Otwórz ponownie ten MR przed aktualizacją decyzji."}}
      }
    },
    "feedbackSuggestions.invalidConcern": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This suggestion could not be verified. Refresh its assessment before deciding."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się zweryfikować sugestii. Odśwież ocenę przed podjęciem decyzji."}}
      }
    },
    "feedbackSuggestions.sourceOpen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open reviewer comment (remaining work not verified)"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Otwarty komentarz recenzenta (pozostałe prace czekają na weryfikację)"}}
      }
    },
    "feedbackSuggestions.sourceStatus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This comes from GitLab’s MR status; no specific source comment was provided."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Informacja pochodzi ze stanu MR w GitLabie. Konkretny komentarz źródłowy jest niedostępny."}}
      }
    },
    "feedbackSuggestions.sourceLoading": {
      "extractionState": "manual",
