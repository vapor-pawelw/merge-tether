{
  "sourceLanguage": "en",
  "strings": {
    "connectionTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Can’t reach GitLab" } }, "pl": {"stringUnit": {"state": "translated", "value": "Brak połączenia z GitLabem"}} } },
    "connectionHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Check your connection or VPN, then retry. Your last available data stays visible." } }, "pl": {"stringUnit": {"state": "translated", "value": "Sprawdź połączenie lub VPN i spróbuj ponownie. Ostatnie dostępne dane pozostają widoczne."}} } },
    "timeoutTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "GitLab took too long to respond" } }, "pl": {"stringUnit": {"state": "translated", "value": "GitLab odpowiada zbyt długo"}} } },
    "timeoutHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Try the refresh again. Your last available data stays visible." } }, "pl": {"stringUnit": {"state": "translated", "value": "Odśwież ponownie. Ostatnie dostępne dane pozostają widoczne."}} } },
    "signInTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "GitLab sign-in required" } }, "pl": {"stringUnit": {"state": "translated", "value": "Wymagane logowanie do GitLaba"}} } },
    "signInHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Sign in with glab, then recheck the connection." } }, "pl": {"stringUnit": {"state": "translated", "value": "Zaloguj się przez glab i ponownie sprawdź połączenie."}} } },
    "hostTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Check the GitLab host" } }, "pl": {"stringUnit": {"state": "translated", "value": "Sprawdź host GitLaba"}} } },
    "hostHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The default host has no verified sign-in. Review your Integration settings." } }, "pl": {"stringUnit": {"state": "translated", "value": "Brak zweryfikowanego logowania do domyślnego hosta. Sprawdź ustawienia GitLaba."}} } },
    "missingTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "GitLab CLI is missing" } }, "pl": {"stringUnit": {"state": "translated", "value": "Brak GitLab CLI"}} } },
    "missingHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Set up glab to connect this app to GitLab." } }, "pl": {"stringUnit": {"state": "translated", "value": "Skonfiguruj glab, aby połączyć aplikację z GitLabem."}} } },
    "permissionsTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "GitLab denied access" } }, "pl": {"stringUnit": {"state": "translated", "value": "GitLab odmówił dostępu"}} } },
    "permissionsHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Review your account’s permissions and token scope in Integration settings." } }, "pl": {"stringUnit": {"state": "translated", "value": "Sprawdź uprawnienia konta i zakres tokena w ustawieniach GitLaba."}} } },
    "responseTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "GitLab returned an unreadable response" } }, "pl": {"stringUnit": {"state": "translated", "value": "GitLab zwrócił nieczytelną odpowiedź"}} } },
    "otherTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Couldn’t refresh GitLab" } }, "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się odświeżyć danych z GitLaba"}} } },
    "retryHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Retry the refresh or inspect the technical details below." } }, "pl": {"stringUnit": {"state": "translated", "value": "Odśwież ponownie lub sprawdź szczegóły techniczne poniżej."}} } },
    "retry": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Retry" } }, "pl": {"stringUnit": {"state": "translated", "value": "Spróbuj ponownie"}} } },
    "signIn": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Sign in…" } }, "pl": {"stringUnit": {"state": "translated", "value": "Zaloguj się…"}} } },
