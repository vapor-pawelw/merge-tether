{
  "sourceLanguage": "en",
  "strings": {
    "reviewIntakeTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incoming review filter"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtr nowych MR-ów do przeglądu"
          }
        }
      }
    },
    "reviewIntakeToggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter new review requests with an agent"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtruj nowe MR-y do przeglądu za pomocą agenta"
          }
        }
      }
    },
    "reviewIntakeCriteria": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter instructions"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrukcje filtrowania"
          }
        }
      }
    },
    "reviewIntakeExampleDraft": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Hide drafts from @release-bot when the title contains “dependency update”." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Ukryj szkice od @release-bot, jeśli tytuł zawiera „dependency update”." } }
      }
    },
    "reviewIntakeExampleProject": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Keep only MRs from platform/api that target main or have the “security” label." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Zachowaj tylko MR-y z platform/api, które mają gałąź docelową main lub etykietę „security”." } }
      }
    },
    "reviewIntakeExampleBranch": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Hide MRs targeting branches that start with release/, unless they have the “hotfix” label." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Ukryj MR-y kierowane do gałęzi zaczynających się od release/, chyba że mają etykietę „hotfix”." } }
      }
    },
    "reviewIntakeExampleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Hide MRs labeled “maintenance” if the author’s GitLab display name contains “Bot”." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Ukryj MR-y z etykietą „maintenance”, jeśli nazwa wyświetlana autora w GitLabie zawiera „Bot”." } }
      }
    },
    "reviewIntakeSave": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save filter"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz filtr"
          }
        }
      }
    },
    "reviewIntakeSaveFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save the review filter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać filtra MR-ów."
          }
        }
      }
    },
    "reviewIntakeHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The filter uses the lightweight verifier configured in Agent settings to assess new requests for Inbox and Reviewing. The verifier needs a working, signed-in CLI. Requests follow the usual workflow if the verifier is unavailable or unsure. Filtered requests can be restored under Reviewing → Hidden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtr używa lekkiego weryfikatora wybranego w ustawieniach agenta do oceny nowych MR-ów trafiających do Inboxa lub Reviewing. Weryfikator wymaga działającego, zalogowanego CLI. Gdy jest niedostępny lub niepewny, MR trafia na zwykłą ścieżkę. Odfiltrowane MR-y możesz przywrócić w sekcji Do przeglądu → Ukryte."
          }
        }
      }
    },
    "reviewIntakeVerifier": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifier: %1$@ · %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weryfikator: %1$@ · %2$@"
          }
        }
      }
    },
    "reviewIntakePaused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The filter is paused while automation is off."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtr jest wstrzymany, gdy automatyzacja jest wyłączona."
          }
        }
      }
    },
    "reviewIntakeChecking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking verifier availability…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzanie dostępności weryfikatora…"
          }
        }
      }
    },
    "reviewIntakeUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review requests follow the usual workflow while the verifier is unavailable."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "MR-y trafiają na zwykłą ścieżkę, ponieważ weryfikator jest niedostępny."
          }
        }
      }
    },
    "reviewIntakeAgentSettings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent settings"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawienia agenta"
          }
        }
      }
    },
    "reviewIntakeNoticeUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter skipped. The verifier was unavailable."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pominięto filtr. Weryfikator był niedostępny."
          }
        }
      }
    },
    "reviewIntakeNoticeInterrupted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter skipped. The assessment was interrupted."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pominięto filtr. Ocena została przerwana."
          }
        }
      }
    },
    "reviewIntakeNoticeFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter skipped. The verifier could not complete the assessment."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pominięto filtr. Weryfikator nie ukończył oceny."
          }
        }
      }
    },
    "reviewIntakeNoticeStorage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter skipped. The assessment could not be saved."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pominięto filtr. Nie udało się zapisać oceny."
          }
        }
      }
    },
    "reviewIntakeNoticeConfiguration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter skipped. The settings changed during the assessment."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pominięto filtr. Ustawienia zmieniły się w trakcie oceny."
          }
        }
      }
    },
    "reviewIntakeNoticeUncertain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verifier could not classify this merge request confidently."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weryfikator nie mógł jednoznacznie ocenić tego MR-a."
          }
        }
      }
    },
    "reviewIntakeNoticeReason": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uncertain assessment. %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niejednoznaczna ocena. %@"
          }
        }
      }
    },
    "reviewIntakeAutomaticallyHidden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verifier hid “%@”."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weryfikator ukrył MR „%@”."
          }
        }
      }
    },
    "reviewIntakeShowHidden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show merge requests"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż MR-y"
          }
        }
      }
    },
    "reviewIntakeAutomaticallyHiddenCount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The verifier hid %lld merge request."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The verifier hid %lld merge requests."
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Weryfikator ukrył %lld MR."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Weryfikator ukrył %lld MR-y."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Weryfikator ukrył %lld MR-ów."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Weryfikator ukrył %lld MR-a."
                }
              }
            }
          }
        }
      }
    },
    "reviewIntakeShowHiddenInInbox": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep automatically hidden merge requests in Inbox"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuj automatycznie ukryte MR-y w Inboxie"
          }
        }
      }
    },
    "reviewIntakeShowHiddenInInboxHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New notices stay in Inbox until you mark them as seen or restore the merge request. Banners still appear."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe wpisy pozostają w Inboxie do oznaczenia jako widziane lub przywrócenia MR-a. Banery nadal się pojawiają."
          }
        }
      }
    },
    "reviewIntakeHiddenByVerifier": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically hidden by the verifier"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie ukryty przez weryfikator"
          }
        }
      }
    },
    "reviewIntakeMarkSeen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark as seen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacz jako widziane"
          }
        }
      }
    },
    "reviewIntakeMarkSeenHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss this Inbox update and keep the merge request hidden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń ten wpis z Inboxa. MR pozostanie ukryty."
          }
        }
      }
    }
  },
  "version": "1.0"
}
