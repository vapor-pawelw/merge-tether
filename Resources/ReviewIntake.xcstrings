{
  "sourceLanguage": "en",
  "strings": {
    "reviewIntakeTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incoming review filter"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtr nowych MR-ów do przeglądu"
          }
        }
      }
    },
    "reviewIntakeToggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filter new review requests with an agent"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtruj nowe MR-y do przeglądu za pomocą agenta"
          }
        }
      }
    },
    "reviewIntakeCriteria": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review criteria"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kryteria przeglądu"
          }
        }
      }
    },
    "reviewIntakeSave": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save filter"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz filtr"
          }
        }
      }
    },
    "reviewIntakeSaveFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save the review filter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać filtra MR-ów."
          }
        }
      }
    },
    "reviewIntakeHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The filter uses the lightweight verifier configured in Agent settings to assess new requests for Inbox and Reviewing. The verifier needs a working, signed-in CLI. Requests follow the usual workflow if the verifier is unavailable or unsure. Filtered requests can be restored under Hidden merge requests."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtr używa lekkiego weryfikatora wybranego w ustawieniach agenta do oceny nowych MR-ów trafiających do Inboxa lub Reviewing. Weryfikator wymaga działającego, zalogowanego CLI. Gdy jest niedostępny lub niepewny, MR trafia na zwykłą ścieżkę. Odfiltrowane MR-y możesz przywrócić na liście ukrytych MR-ów."
          }
        }
      }
    },
    "reviewIntakeVerifier": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifier: %1$@ · %2$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weryfikator: %1$@ · %2$@"
          }
        }
      }
    },
    "reviewIntakePaused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The filter is paused while automation is off."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtr jest wstrzymany, gdy automatyzacja jest wyłączona."
          }
        }
      }
    },
    "reviewIntakeChecking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking verifier availability…"
