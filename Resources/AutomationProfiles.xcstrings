{
  "sourceLanguage": "en",
  "strings": {
    "automatic": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "automatic" } } } },
    "manualAction": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "manual" } } } },
    "customPrivateHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Enabled analyses, private drafts and local preparation can run automatically. Publication, approval, pushes, merge and all other public actions wait for you." } } } },
    "customPublicSummary.%@.%@.%@.%@": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "After current checks — approval: %1$@; follow-up push: %2$@; conflict push: %3$@; merge: %4$@." } } } },
    "chooseHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Choose how much work to automate. The controls below follow your selection immediately; Apply Changes saves them." } } } },
    "revert": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Revert Changes" } } } },
    "saveFailed": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The settings or Custom history could not be saved. The previous saved Custom is retained. Retry Apply Changes." } } } },
    "historyReadFailed": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Saved Custom history could not be read. Your active settings are unchanged." } } } },
    "automationEnabled": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Enable automatic work" } } } },
    "enableFirst": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Automatic work is off. Choose a profile or enable it here before adjusting its active permissions. Changes take effect only after Apply Changes." } } } },
    "permissionsLocation": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Enablement and action permissions are managed together in Profile & permissions." } } } },
    "eventFiltersLocation": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Repository, branch, label and waiting-period filters stay in MR Events. Profiles preserve these filters." } } } },
    "pipelineRetryInactive": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Infrastructure retry is inactive until its requirements below are met. Your saved retry preference is retained." } } } },
    "pipelineRetryHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Requires automatic public actions, the pipeline event set to Run with coding agent CLI, and a repository explicitly listed in its MR Events filter. The app retries the job independently of worker tool access. Other verification checks still apply." } } } },
    "handlerAcknowledgements": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Legacy handler completion acknowledgements" } } } },
    "reviewHandlerAcknowledgement": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Mark review-handler to-dos read after completion" } } } },
    "feedbackHandlerAcknowledgement": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Mark feedback-handler to-dos read after completion" } } } },
    "handlerAcknowledgementHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "These retained options concern handler completion only. Recognized MR events are acknowledged separately after durable routing, under the automatic public-action permission. Private work blocks both automatic acknowledgements." } } } },
    "previewTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Selected profile preview" } } } },
    "manualTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Manual" } } } },
    "safeTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Safe" } } } },
    "trustedTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Trusted" } } } },
    "maxTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Max" } } } },
    "manualHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "You choose when to analyze, review and act. Automatic work is off; explicit manual actions remain available." } } } },
    "maxHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Handle all supported work automatically, including eligible comment publication and merging. Your scope, ownership, permissions and current verification checks still apply." } } } },
    "safeDoes": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Does: analyze, review, verify feedback, save private review drafts and prepare local code, conflict and pipeline proposals using full tools." } } } },
    "safeDoesNot": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Does not: publish, approve, merge, push, resolve discussions, request reviews, add reactions, mark GitLab to-dos read or change CI automatically. Local follow-up proposals stay in the run result until delivered and verified. Explicit manual actions remain available." } } } },
    "trustedDoes": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Does: automatic analysis, review and fixes; verified follow-up and conflict pushes; approvals, eligible discussion resolution, re-review requests and pipeline work. Publishes only checked replies to verified or high-confidence AI-assisted feedback, subject to saved filters." } } } },
    "trustedDoesNot": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Does not: merge automatically or publish general findings and replies to manual, uncertain or unassessed feedback. Those remain private for your decision. All current safety and scope checks still apply." } } } },
    "customizedTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Custom" } } } },
    "customizedHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The controls below show your actual permissions. Choosing a profile fills this form immediately; live settings change only after Apply Changes." } } } },
    "legacyHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Your previous With checkpoints settings are retained. They do not grant Trusted’s additional permissions. Review the actual controls below or explicitly choose a new profile." } } } },
    "privateToggle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Keep automatic work private" } } } },
    "privateHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Allow private drafts and local preparation while blocking every automatic public GitLab action, including pushes, CI changes, reactions and to-do acknowledgements. Other saved permissions remain visible and can apply when this restriction is turned off. Manual actions remain separate." } } } },
    "privateWork": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Automatic work stays private; public actions wait for you" } } } }
  },
  "version": "1.0"
}
