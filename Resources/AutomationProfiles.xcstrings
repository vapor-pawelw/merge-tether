{
  "sourceLanguage": "en",
  "strings": {
    "globallyEnabled": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Automation enabled across the app" } }, "pl": {"stringUnit": {"state": "translated", "value": "Automatyzacja włączona globalnie"}} } },
    "globallyPaused": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Automation paused across the app" } }, "pl": {"stringUnit": {"state": "translated", "value": "Automatyzacja wstrzymana globalnie"}} } },
    "unsavedChanges": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Unsaved changes" } }, "pl": {"stringUnit": {"state": "translated", "value": "Niezapisane zmiany"}} } },
    "savesImmediately": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Changes here save immediately." } }, "pl": {"stringUnit": {"state": "translated", "value": "Zmiany w tej sekcji zapisują się od razu."}} } },
    "publicationPage": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Publish & merge" } }, "pl": {"stringUnit": {"state": "translated", "value": "Publikacja i scalanie"}} } },
    "profileRulesSection": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Profile and automatic work" } }, "pl": {"stringUnit": {"state": "translated", "value": "Profil i reguły automatyzacji"}} } },
    "enableProfileRules": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Enable rules in this profile" } }, "pl": {"stringUnit": {"state": "translated", "value": "Włącz reguły tego profilu"}} } },
    "scopeOverview": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Choose which repositories and merge requests these rules apply to." } }, "pl": {"stringUnit": {"state": "translated", "value": "Wybierz repozytoria i merge requesty, których dotyczą te reguły."}} } },
    "openScope": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Edit scope" } }, "pl": {"stringUnit": {"state": "translated", "value": "Edytuj zakres"}} } },
    "reviewRequestsSection": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Incoming review requests" } }, "pl": {"stringUnit": {"state": "translated", "value": "Prośby o przegląd"}} } },
    "handleReviewRequests": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Handle review requests automatically" } }, "pl": {"stringUnit": {"state": "translated", "value": "Obsługuj prośby o przegląd automatycznie"}} } },
    "reviewerActionsSection": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "When I review a merge request" } }, "pl": {"stringUnit": {"state": "translated", "value": "Gdy jestem recenzentem"}} } },
    "authorFeedbackSection": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Feedback on my merge requests" } }, "pl": {"stringUnit": {"state": "translated", "value": "Uwagi do moich merge requestów"}} } },
    "handleAuthorFeedback": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Handle feedback on my merge requests automatically" } }, "pl": {"stringUnit": {"state": "translated", "value": "Obsługuj uwagi do moich MR-ów automatycznie"}} } },
    "authorReviewCompletionSection": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Re-review and discussion resolution" } }, "pl": {"stringUnit": {"state": "translated", "value": "Ponowny przegląd i zamykanie dyskusji"}} } },
    "ruleDetails": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Repositories and task instructions" } }, "pl": {"stringUnit": {"state": "translated", "value": "Repozytoria i instrukcje zadania"}} } },
    "conflictSection": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Merge conflicts" } }, "pl": {"stringUnit": {"state": "translated", "value": "Konflikty przy scalaniu"}} } },
    "mergeSection": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Merging my merge requests" } }, "pl": {"stringUnit": {"state": "translated", "value": "Scalanie moich merge requestów"}} } },
    "eventFilters": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "When this rule applies" } }, "pl": {"stringUnit": {"state": "translated", "value": "Kiedy stosować tę regułę"}} } },
    "pipelineSection": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Actions for failed pipelines" } }, "pl": {"stringUnit": {"state": "translated", "value": "Działania po błędzie pipeline’u"}} } },
    "pipelineRetryNeedsAgent": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "To retry a pipeline job, set Action to Run with coding agent CLI." } }, "pl": {"stringUnit": {"state": "translated", "value": "Aby ponawiać zadanie pipeline’u, ustaw działanie na „Uruchom przez CLI asystenta”."}} } },
    "pipelineRetryNeedsProjects": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "List the repositories where MergeTether may retry jobs in the filter above." } }, "pl": {"stringUnit": {"state": "translated", "value": "W filtrze powyżej wpisz repozytoria, w których MergeTether może ponawiać zadania."}} } },
    "writesBlockedBySavedData": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Automatic public GitLab actions are paused because saved data could not be verified." } }, "pl": {"stringUnit": {"state": "translated", "value": "Automatyczne działania publiczne w GitLabie są wstrzymane z powodu problemu z zapisanymi danymi."}} } },
    "writesBlockedByGlobalPause": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Automatic public GitLab actions will wait until automation resumes." } }, "pl": {"stringUnit": {"state": "translated", "value": "Automatyczne działania publiczne w GitLabie czekają na wznowienie automatyzacji."}} } },
    "writesBlockedByProfile": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Enable rules in the profile to allow automatic GitLab changes." } }, "pl": {"stringUnit": {"state": "translated", "value": "Włącz reguły profilu, aby zezwolić na automatyczne działania publiczne w GitLabie."}} } },
    "writesBlockedByPrivateMode": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Private mode blocks automatic GitLab changes." } }, "pl": {"stringUnit": {"state": "translated", "value": "Tryb prywatny blokuje automatyczne działania publiczne w GitLabie."}} } },
    "manualJobsCanPush": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "An author follow-up you start can still push verified fixes." } }, "pl": {"stringUnit": {"state": "translated", "value": "Zadanie obsługi uwag uruchomione ręcznie może wysłać zweryfikowane poprawki."}} } },
    "manualJobsCanResolveThreads": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "A re-review you start can still resolve your verified findings." } }, "pl": {"stringUnit": {"state": "translated", "value": "Ręcznie uruchomiony ponowny przegląd może zamknąć Twoje zweryfikowane uwagi."}} } },
    "conflictPushNeedsProjectPermission": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Conflict pushes also require project permission below." } }, "pl": {"stringUnit": {"state": "translated", "value": "Wysyłanie poprawek konfliktów wymaga także uprawnienia projektowego poniżej."}} } },
    "manualConflictJobsCanPush": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "A conflict task you start can still push fixes in permitted repositories." } }, "pl": {"stringUnit": {"state": "translated", "value": "Ręcznie uruchomione zadanie rozwiązania konfliktu może wysłać poprawki w dozwolonych repozytoriach."}} } },
    "automatic": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "automatic" } }, "pl": {"stringUnit": {"state": "translated", "value": "automatycznie"}} } },
    "manualAction": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "manual" } }, "pl": {"stringUnit": {"state": "translated", "value": "ręcznie"}} } },
    "customPrivateHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Enabled analyses, private drafts and local preparation can run automatically. Publication, approval, pushes, merge and all other public actions wait for you." } }, "pl": {"stringUnit": {"state": "translated", "value": "Włączone analizy, prywatne wersje robocze i lokalne przygotowanie mogą działać automatycznie. Publikacja, zatwierdzanie, wypychanie zmian, scalanie i wszystkie inne działania publiczne wymagają Twojej decyzji."}} } },
    "customPublicSummary.%@.%@.%@.%@": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "After current checks — approval: %1$@; follow-up push: %2$@; conflict push: %3$@; merge: %4$@." } }, "pl": {"stringUnit": {"state": "translated", "value": "Zatwierdzanie (%1$@) · push po uwagach (%2$@) · push po konflikcie (%3$@) · scalanie (%4$@)."}} } },
    "chooseHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Choose a profile, then select Apply Changes to save it." } }, "pl": {"stringUnit": {"state": "translated", "value": "Wybierz profil, a następnie zastosuj zmiany, aby go zapisać."}} } },
    "revert": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Revert Changes" } }, "pl": {"stringUnit": {"state": "translated", "value": "Cofnij zmiany"}} } },
    "saveFailed": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The settings or Custom history could not be saved. The previous saved Custom is retained. Retry Apply Changes." } }, "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się zapisać ustawień lub historii profilu Niestandardowy. Poprzedni zapisany profil pozostaje zachowany. Ponów próbę zastosowania zmian."}} } },
    "historyReadFailed": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Saved Custom history could not be read. Your active settings are unchanged." } }, "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się odczytać zapisanej historii profilu Niestandardowy. Aktywne ustawienia nie uległy zmianie."}} } },
    "automationEnabled": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Enable automatic work" } }, "pl": {"stringUnit": {"state": "translated", "value": "Włącz automatyczne działania"}} } },
    "enableFirst": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Automatic work is off. Choose a profile or enable it here before adjusting its active permissions. Changes take effect only after Apply Changes." } }, "pl": {"stringUnit": {"state": "translated", "value": "Automatyczne działania są wyłączone. Wybierz profil lub włącz je tutaj, zanim zmienisz aktywne uprawnienia. Zmiany zaczną obowiązywać po zastosowaniu."}} } },
    "permissionsLocation": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Enablement and action permissions are managed together in Profile & permissions." } }, "pl": {"stringUnit": {"state": "translated", "value": "Włączanie i uprawnienia do działań są zarządzane razem w sekcji Profil i uprawnienia."}} } },
    "eventFiltersLocation": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Repository, branch, label and waiting-period filters stay in MR Events. Profiles preserve these filters." } }, "pl": {"stringUnit": {"state": "translated", "value": "Filtry repozytorium, gałęzi, etykiet i czasu oczekiwania pozostają w sekcji Zdarzenia MR. Profile zachowują te filtry."}} } },
    "pipelineRetryInactive": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Infrastructure retry is inactive until its requirements below are met. Your saved retry preference is retained." } }, "pl": {"stringUnit": {"state": "translated", "value": "Ponawianie potoku jest nieaktywne, dopóki nie zostaną spełnione poniższe wymagania. Zapisana preferencja ponawiania została zachowana."}} } },
    "pipelineRetryHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Requires automatic public actions, the pipeline event set to Run with coding agent CLI, and a repository explicitly listed in its MR Events filter. The app retries the job independently of worker tool access. Other verification checks still apply." } }, "pl": {"stringUnit": {"state": "translated", "value": "Wymaga automatycznych działań publicznych, zestawu zdarzeń potoku ustawionego na Uruchom przez CLI agenta kodującego oraz repozytorium jawnie wymienionego w filtrze Zdarzeń MR. Aplikacja ponawia zadanie niezależnie od dostępu agenta do narzędzi. Nadal obowiązują pozostałe kontrole."}} } },
    "handlerAcknowledgements": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Legacy handler completion acknowledgements" } }, "pl": {"stringUnit": {"state": "translated", "value": "Potwierdzenia ukończenia starszych procedur obsługi"}} } },
    "reviewHandlerAcknowledgement": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Mark review-handler to-dos read after completion" } }, "pl": {"stringUnit": {"state": "translated", "value": "Oznacz zadanie przeglądu jako przeczytane po jego obsłużeniu"}} } },
    "feedbackHandlerAcknowledgement": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Mark feedback-handler to-dos read after completion" } }, "pl": {"stringUnit": {"state": "translated", "value": "Oznacz zadanie dotyczące uwag jako przeczytane po jego obsłużeniu"}} } },
    "handlerAcknowledgementHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "These retained options concern handler completion only. Recognized MR events are acknowledged separately after durable routing, under the automatic public-action permission. Private work blocks both automatic acknowledgements." } }, "pl": {"stringUnit": {"state": "translated", "value": "Te zachowane opcje dotyczą wyłącznie zakończenia procedury obsługi. Rozpoznane zdarzenia MR są potwierdzane osobno po trwałym przekierowaniu, zgodnie z uprawnieniem do automatycznych działań publicznych. Prywatna praca blokuje oba automatyczne potwierdzenia."}} } },
    "previewTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Selected profile preview" } }, "pl": {"stringUnit": {"state": "translated", "value": "Podgląd wybranego profilu"}} } },
    "manualTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Manual" } }, "pl": {"stringUnit": {"state": "translated", "value": "Ręczny"}} } },
    "safeTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Safe" } }, "pl": {"stringUnit": {"state": "translated", "value": "Safe"}} } },
    "trustedTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Trusted" } }, "pl": {"stringUnit": {"state": "translated", "value": "Trusted"}} } },
    "maxTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Max" } }, "pl": {"stringUnit": {"state": "translated", "value": "Max"}} } },
    "manualHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "You choose when to analyze, review and act. Automatic work is off; explicit manual actions remain available." } }, "pl": {"stringUnit": {"state": "translated", "value": "Samodzielnie decydujesz, kiedy rozpocząć analizę lub przegląd i wykonać działanie. Automatyzacja jest wyłączona, a ręczne działania są dostępne."}} } },
    "maxHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Handle all supported work automatically, including eligible comment publication and merging. Your scope, ownership, permissions and current verification checks still apply." } }, "pl": {"stringUnit": {"state": "translated", "value": "Automatyzuj wszystkie obsługiwane działania, w tym publikowanie komentarzy i scalanie, gdy spełnione są wymagania. Nadal obowiązują ustawiony zakres, uprawnienia, reguły własności i bieżąca weryfikacja."}} } },
    "safeDoes": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Does: analyze, review, verify feedback, save private review drafts and prepare local code, conflict and pipeline proposals using full tools." } }, "pl": {"stringUnit": {"state": "translated", "value": "Automatycznie analizuje merge requesty, wykonuje przeglądy, weryfikuje uwagi, zapisuje prywatne szkice i przygotowuje lokalne propozycje zmian w kodzie, rozwiązania konfliktów oraz poprawek pipeline’ów. Asystent ma pełny dostęp do narzędzi."}} } },
    "safeDoesNot": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Does not: publish, approve, merge, push, resolve discussions, request reviews, add reactions, mark GitLab to-dos read or change CI automatically. Local follow-up proposals stay in the run result until delivered and verified. Explicit manual actions remain available." } }, "pl": {"stringUnit": {"state": "translated", "value": "Publikowanie, zatwierdzanie, scalanie, push, zamykanie dyskusji, prośby o przegląd, reakcje, oznaczanie zadań jako przeczytane i zmiany CI wymagają ręcznej decyzji. Lokalne propozycje poprawek pozostają w wyniku zadania do czasu ich dostarczenia i weryfikacji."}} } },
    "trustedDoes": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Does: automatic analysis, review and fixes; verified follow-up and conflict pushes; approvals, eligible discussion resolution, re-review requests and pipeline work. Publishes only checked replies to verified bot accounts or verified/high-confidence AI-assisted feedback, subject to saved filters." } }, "pl": {"stringUnit": {"state": "translated", "value": "Automatycznie analizuje, przegląda i poprawia kod. Może wysyłać zweryfikowane poprawki, zatwierdzać zmiany, rozwiązywać kwalifikujące się dyskusje, prosić o ponowny przegląd i obsługiwać pipeline’y. Publikuje sprawdzone odpowiedzi do zweryfikowanych botów i uwag wspomaganych przez AI z odpowiednią pewnością, zgodnie z zapisanymi filtrami."}} } },
    "trustedDoesNot": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Does not: merge automatically or publish general findings and replies to manual, uncertain or unassessed feedback. Those remain private for your decision. All current safety and scope checks still apply." } }, "pl": {"stringUnit": {"state": "translated", "value": "Scalanie oraz publikowanie ogólnych uwag i odpowiedzi do ludzi lub uwag o niepewnym bądź nieustalonym pochodzeniu wymagają Twojej decyzji. Nadal obowiązują ustawiony zakres i bieżąca weryfikacja."}} } },
    "customizedTitle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Custom" } }, "pl": {"stringUnit": {"state": "translated", "value": "Niestandardowy"}} } },
    "customizedHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The other Automation pages show the configured rules and permissions. Apply Changes saves the current configuration." } }, "pl": {"stringUnit": {"state": "translated", "value": "Reguły i uprawnienia znajdziesz na pozostałych stronach Automatyzacji. Zapiszesz je przyciskiem „Zastosuj zmiany”."}} } },
    "legacyHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Your previous With checkpoints settings are retained. They do not grant Trusted’s additional permissions. Review the actual controls below or explicitly choose a new profile." } }, "pl": {"stringUnit": {"state": "translated", "value": "Poprzednie ustawienia Z kontrolami zostały zachowane. Nie przyznają dodatkowych uprawnień profilu Zaufany. Sprawdź poniższe ustawienia lub jawnie wybierz nowy profil."}} } },
    "privateToggle": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Keep automatic work private" } }, "pl": {"stringUnit": {"state": "translated", "value": "Przygotowuj zmiany w trybie prywatnym"}} } },
    "privateHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Allow private drafts and local preparation while blocking every automatic public GitLab action, including pushes, CI changes, reactions and to-do acknowledgements. Other saved permissions remain visible and can apply when this restriction is turned off. Manual actions remain separate." } }, "pl": {"stringUnit": {"state": "translated", "value": "Zezwalaj na prywatne wersje robocze i lokalne przygotowanie, blokując wszystkie automatyczne publiczne działania GitLab, w tym wypychanie zmian, zmiany CI, reakcje i potwierdzenia zadań. Pozostałe zapisane uprawnienia są widoczne i mogą obowiązywać po wyłączeniu tego ograniczenia. Ręczne działania są niezależne."}} } },
    "privateWork": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Automatic work stays private; public actions wait for you" } }, "pl": {"stringUnit": {"state": "translated", "value": "Automatyczne działania pozostają prywatne; działania publiczne wymagają Twojej decyzji"}} } }
  },
  "version": "1.0"
}
