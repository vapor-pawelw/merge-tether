      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitLab could not confirm this merge request is ready. Refresh its status and try again."
          }
        }
      }
    },
    "accountChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The GitLab account changed or sign-in could not be verified. Refresh and check your GitLab account."
          }
        }
      }
    },
