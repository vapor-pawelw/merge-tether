    "failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not confirm readiness"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się potwierdzić gotowości"}}
      }
    },
    "failedHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitLab could not confirm this merge request is ready. Refresh its status and try again."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "GitLab nie potwierdził gotowości merge requesta. Odśwież jego stan i spróbuj ponownie."}}
      }
    },
    "accountChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The GitLab account changed or sign-in could not be verified. Refresh and check your GitLab account."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Konto GitLaba się zmieniło lub logowania nie udało się zweryfikować. Odśwież dane i sprawdź konto."}}
      }
    },
    "changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The merge request or account changed before this action could finish. Refresh its GitLab status."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Przed zakończeniem działania zmienił się merge request lub konto. Odśwież stan w GitLabie."}}
      }
    },
    "ok": {
      "extractionState": "manual",
