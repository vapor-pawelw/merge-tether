          "stringUnit": {
            "state": "translated",
            "value": "Replies to AI feedback"
          }
        }
      }
    },
    "settings.automation.publication.manual": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private drafts only"
          }
        }
      }
    },
    "settings.automation.publication.allHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publish eligible checked drafts automatically after they remain unchanged across two refreshes and current verification passes. Optional restrictions can narrow this further."
          }
        }
      }
    },
    "settings.automation.publication.aiRepliesHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically publish checked replies to verified AI comments or comments assessed as AI-assisted with high or very high confidence. Likely manual or uncertain comments and new standalone comments stay private. Optional restrictions can narrow this further."
          }
        }
      }
    },
    "settings.automation.publication.manualHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep comments and replies as private drafts until you explicitly publish them. Automatic publication is off."
          }
        }
      }
    },
