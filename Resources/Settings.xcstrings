    "settings.codexPlugin.enabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plugin is enabled. In Codex, go to Plugins → MergeTether → Setup and confirm the schedule. If the plugin is not visible, reopen Codex."
