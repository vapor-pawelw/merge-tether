    },
    "settings.automation.codexRelayHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex review and follow-up tasks use glab to read their merge request. Set up the listener in the MergeTether plugin. Codex tool approvals still apply."
          }
        }
      }
    },
