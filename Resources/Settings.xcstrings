        }
      }
    },
    "settings.automation.command": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command"
          }
        }
      }
    },
    "settings.automation.command.example": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"$HOME/bin/review-mr\" \"$GITLAB_MR_URL\""
          }
        }
      }
    },
    "settings.automation.command.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs with your macOS account permissions using zsh. Exit with code 0 once the task has been handed off. GitLab details are available as environment variables."
          }
        }
      }
    },
    "settings.automation.command.variables": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GITLAB_TODO_ID, GITLAB_MR_IID, GITLAB_MR_URL, GITLAB_MR_TITLE, GITLAB_PROJECT_PATH, GITLAB_MR_AUTHOR, GITLAB_TODO_ACTOR, GITLAB_TODO_ACTOR_USERNAME, GITLAB_TODO_EVENT, GITLAB_TASK_TITLE"
          }
        }
      }
    },
