    "settings.automation.codexTemplate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a verified permission template for new chats (beta)"
          }
        }
      }
    },
    "settings.automation.codexTemplateHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Codex chats inherit the verified template’s access settings. Existing chats keep their own settings. MergeTether does not change Codex permissions."
          }
        }
      }
    },
    "settings.automation.codexTemplateMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No verified template yet. Open Setup Chat in the MergeTether plugin to prepare one. Until then, new chats open normally and may ask for tool approval."
          }
        }
      }
    },
    "settings.automation.codexTemplateOpen": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open verified template chat"
          }
        }
      }
    },
    "settings.automation.codexTemplateReset": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset template"
          }
        }
      }
    },
    "settings.automation.codexTemplateResetHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forgets MergeTether’s saved template link so Setup can register another chat. Keeps existing chats, queued work and Codex permissions unchanged."
          }
        }
      }
    },
    "settings.automation.codexTemplateResetFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reset the saved template. Check access to MergeTether’s local queue and try again."
          }
        }
      }
    },
    "settings.automation.codexRelay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a Codex listener for automatic GUI chats"
