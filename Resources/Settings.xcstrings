      }
    },
    "settings.verification.enabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify feedback automatically before requesting re-review"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatycznie weryfikuj uwagi przed prośbą o ponowny przegląd"}}
      }
    },
    "settings.verification.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assess comments and the current diff with the selected CLI before requesting re-review. When off or a check is inconclusive, confirm readiness manually. Other coding agent automation still requires a signed-in CLI."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Przed prośbą o ponowny przegląd sprawdź komentarze i aktualny diff za pomocą wybranego CLI. Gdy weryfikacja jest wyłączona lub wynik jest niejednoznaczny, potwierdź gotowość ręcznie. Pozostałe zadania automatyzacji asystenta nadal wymagają zalogowanego CLI."}}
      }
    },
    "settings.verification.thinking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification reasoning"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Poziom rozumowania weryfikatora"}}
      }
    },
    "settings.verification.model": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification model"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Model weryfikacji"}}
      }
    },
    "settings.verification.model.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "The verifier checks reviewer feedback, assesses comments, and performs other read-only checks."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Weryfikator sprawdza uwagi recenzentów, ocenia komentarze i wykonuje inne kontrole w trybie odczytu."}}
      }
    },
    "settings.automation.runner.legacyHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This saved script is retained for reference. MR automation no longer runs scripts or substitutes AI for them. Choose the coding agent CLI to enable this handler."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zapisany skrypt jest dostępny jako punkt odniesienia. Obecna automatyzacja MR używa wybranego CLI asystenta. Wybierz je, aby włączyć tę procedurę."}}
      }
    },
    "settings.general.notifications.permission.prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow system notifications for work that needs your attention."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zezwól MergeTether na wysyłanie powiadomień systemowych."}}
      }
    },
    "settings.general.notifications.permission.enable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable notifications"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Włącz powiadomienia"}}
      }
    },
    "settings.general.notifications.permission.enabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System notifications are enabled."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Powiadomienia systemowe są włączone."}}
      }
    },
    "settings.integration.auth.unverified": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in not verified"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Logowanie bez weryfikacji"}}
      }
    },
    "settings.automation.package.full": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full automation"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Pełna automatyzacja"}}
      }
    },
    "settings.automation.package.fullHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically run reviews, feedback fixes, CI workflows, publication of all eligible comments, approvals, thread resolution and eligible merges. Verified follow-up and conflict fixes may be pushed within active Scope. Project and verification checks still apply."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatycznie wykonuj przeglądy, poprawki po uwagach i zadania CI, publikuj wszystkie kwalifikujące się komentarze, zatwierdzaj, zamykaj dyskusje i scalaj kwalifikujące się MR. Zweryfikowane poprawki po uwagach i konfliktach mogą zostać wysłane w aktywnym zakresie. Nadal obowiązują ograniczenia projektowe i weryfikacja."}}
      }
    },
    "settings.automation.package.checkpointsHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run reviews, diagnoses and local fix proposals automatically. Publish checked replies to likely AI-assisted comments; other comments await confirmation. Pushes, approvals, merges and thread resolution are manual. Readiness verification and re-review requests stay on."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatycznie wykonuj przeglądy, diagnozy i lokalne propozycje poprawek. Publikuj sprawdzone odpowiedzi na komentarze prawdopodobnie wspomagane przez AI. Pozostałe komentarze czekają na potwierdzenie. Wysyłanie commitów, zatwierdzanie, scalanie i zamykanie dyskusji są ręczne. Weryfikacja gotowości i prośby o ponowny przegląd pozostają włączone."}}
      }
    },
    "settings.automation.package.manualHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor MRs and manage actions manually. Automatic runs, verification and remote actions are off. You can explicitly start a coding-agent review when a signed-in CLI is available."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Monitoruj MR i wykonuj działania ręcznie. Automatyczne zadania, weryfikacja i działania zdalne są wyłączone. Przegląd przez asystenta możesz uruchomić ręcznie, gdy zalogowane CLI jest dostępne."}}
      }
    },
    "settings.automation.publication.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment publication"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Publikacja komentarzy"}}
      }
    },
    "settings.automation.publication.all": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All eligible comments"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wszystkie kwalifikujące się komentarze"}}
      }
    },
    "settings.automation.publication.aiReplies": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replies to AI or bot feedback"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Odpowiedzi na uwagi AI i botów"}}
      }
    },
    "settings.automation.publication.manual": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private drafts only"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Tylko prywatne szkice"}}
      }
    },
    "settings.automation.publication.allHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Publish eligible checked drafts automatically after they remain unchanged across two refreshes and current verification passes. Optional restrictions can narrow this further."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Publikuj automatycznie kwalifikujące się, sprawdzone szkice, jeśli po dwóch odświeżeniach ich treść pozostaje taka sama i bieżąca weryfikacja przebiegnie pomyślnie. Opcjonalne ograniczenia pozwalają zawęzić zakres."}}
      }
    },
    "settings.automation.publication.aiRepliesHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically publish checked replies to verified AI comments or comments assessed as AI-assisted with high or very high confidence. Known bots have a fixed Bot classification, regardless of whether scripts or AI produced their text. When bot replies are allowed, those accounts qualify through that separate permission without an AI assessment. Other likely manual or uncertain comments and new standalone comments stay private. Optional restrictions can narrow this further."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatycznie publikuj sprawdzone odpowiedzi na zweryfikowane komentarze AI lub komentarze ocenione z wysoką albo bardzo wysoką pewnością jako wspomagane przez AI. Rozpoznane boty mają stałą klasyfikację „Bot”, niezależnie od tego, czy tekst powstał przez skrypt czy AI. Po włączeniu odpowiedzi do botów te konta kwalifikują się na podstawie osobnego uprawnienia i bez oceny AI. Inne komentarze uznane za prawdopodobnie ręczne, komentarze o niepewnym pochodzeniu oraz nowe samodzielne komentarze pozostają prywatne. Opcjonalne ograniczenia pozwalają zawęzić zakres."}}
      }
    },
    "settings.automation.publication.manualHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep comments and replies as private drafts until you explicitly publish them. Automatic publication is off."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zachowuj komentarze i odpowiedzi jako prywatne szkice do czasu ręcznej publikacji. Automatyczna publikacja jest wyłączona."}}
      }
    },
    "settings.automation.pipelineOwnership": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically claim failed pipeline work"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatycznie podejmuj naprawę nieudanych pipeline’ów"}}
      }
    },
    "settings.automation.pipelineOwnershipHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check existing reservations and atomically claim unowned failures on your MRs. Turn off to confirm each handoff. Pipeline evidence and push permissions are checked separately."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Sprawdzaj istniejące rezerwacje i atomowo rezerwuj obsługę wolnych awarii w Twoich MR. Wyłącz tę opcję, aby potwierdzać każde przekazanie. Dane pipeline’u i uprawnienie do wysyłania zmian są sprawdzane osobno."}}
      }
    },
    "settings.assignedOwnership.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Use assignees to determine which MRs are mine" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Ustalaj, które MR-y są moje, według przypisania" } }
      }
    },
    "settings.assignedOwnership.help": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Mine and its automation follow the assignee list. If a merge request has no assignees, its author is responsible." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Sekcja Moje i jej automatyzacja uwzględniają listę przypisanych osób. Gdy lista jest pusta, za MR odpowiada autor." } }
      }
    },
    "settings.general.newReviews.section": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "New reviews" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Nowe review" } }
      }
    },
    "settings.general.newReviews.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Add new review requests straight to Reviewing" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Dodawaj nowe prośby o review od razu do Reviewing" } }
      }
    },
    "settings.general.newReviews.help": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "New merge requests you are asked to review appear in Reviewing marked New. Turn this off to keep them in the inbox until you add or ignore each one. Nothing is reviewed until it is started, unless automation is set to start it." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Nowe MR-y, które masz zreviewować, trafiają do Reviewing z oznaczeniem Nowe. Wyłącz, aby zostawały w skrzynce, dopóki nie dodasz lub zignorujesz każdego z nich. Review nie startuje samo, chyba że ustawisz to w automatyzacji." } }
      }
    },
    "settings.automation.startNewReviews": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Start reviewing new merge requests automatically" } },
        "pl": { "stringUnit": { "state": "translated", "value": "Automatycznie rozpoczynaj review nowych MR-ów" } }
      }
    },
    "settings.automation.startNewReviewsHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "A new review request starts its review as soon as it reaches Reviewing, when your rules allow it. Turn off to start each one yourself; its automation stays paused until you do." } },
        "pl": { "stringUnit": { "state": "translated", "value": "Nowa prośba o review rozpoczyna review od razu po trafieniu do Reviewing, jeśli pozwalają na to Twoje reguły. Wyłącz, aby startować każdą samodzielnie; jej automatyzacja pozostaje wstrzymana do tego czasu." } }
      }
    }
  },
  "version": "1.0"
}
