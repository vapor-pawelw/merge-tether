{
  "sourceLanguage": "en",
  "strings": {
    "settings.automation.requireAssignmentClaim": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm assigned requests before starting automation"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierdzaj przejęcie przypisanych MR-ów przed startem automatyzacji"
          }
        }
      }
    },
    "settings.automation.requireAssignmentClaimHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When someone else authored an assigned merge request, it waits for you to claim it on the board before automation can run."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy ktoś przypisze Ci MR innego autora, karta czeka na przejęcie przed uruchomieniem automatyzacji."
          }
        }
      }
    },
    "settings.automation.actionOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączone"
          }
        }
      }
    },
    "settings.automation.actionOn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączone"
          }
        }
      }
    },
    "settings.automation.actionByPrompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By prompt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Według promptu"
          }
        }
      }
    },
    "settings.automation.approvalPrompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic approval criteria"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kryteria automatycznej akceptacji"
          }
        }
      }
    },
    "settings.automation.mergePrompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic merge criteria"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kryteria automatycznego scalenia"
          }
        }
      }
    },
    "settings.automation.actionPromptHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe which merge requests to allow or exclude. The verifier checks only eligible requests that use Default. Missing or uncertain decisions leave the action for you."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz, które MR-y dopuścić lub wykluczyć. Weryfikator sprawdza tylko gotowe MR-y z ustawieniem Domyślne. Przy braku pewnej decyzji akcja pozostaje do wykonania ręcznie."
          }
        }
      }
    },
    "settings.automation.mergeAuthorOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically merge only requests I authored"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scalaj automatycznie tylko MR-y mojego autorstwa"
          }
        }
      }
    },
    "settings.automation.mergeAuthorOnlyHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This also applies when automatic merge is set to On for an individual request."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotyczy również MR-ów z automatycznym scalaniem ustawionym na Włączone."
          }
        }
      }
    },
    "settings.codingAgentPreferences": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Agent settings"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Ustawienia agenta"}}
      }
    },
    "settings.requireReviewStartConfirmation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Require confirmation to start a review"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagaj potwierdzenia startu recenzji"
          }
        }
      }
    },
    "settings.assistant.resumeAction": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Set up agent and resume…"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Skonfiguruj asystenta i wznów…"}}
      }
    },
    "settings.assistant.requiredBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Choose a signed-in coding agent in Settings, then try this action again."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Wybierz zalogowanego asystenta w ustawieniach i ponów tę czynność."}}
      }
    },
    "settings.assistant.requiredTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Coding agent unavailable"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Asystent jest niedostępny"}}
      }
    },
    "settings.assistant.useHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "MergeTether runs agent tasks through Codex CLI or Claude CLI."}},
        "pl": {"stringUnit": {"state": "translated", "value": "MergeTether uruchamia zadania asystenta przez Codex CLI lub Claude CLI."}}
      }
    },
    "settings.assistant.applyNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Click Apply Changes to save your selection. MergeTether will run the selected agent when an automation needs it."}},
        "pl": {"stringUnit": {"state": "translated", "value": "Kliknij „Zastosuj zmiany”, aby zapisać wybór. MergeTether uruchomi wybranego agenta w automatyzacjach, które go potrzebują."}}
      }
    },
    "settings.codingAgent.showNonRecommendedModels": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "Show non-recommended models"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Pokaż też modele spoza zaleceń"}}
      }
    },
    "settings.assistant.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {"stringUnit": {"state": "translated", "value": "No coding agent"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Brak asystenta"}}
      }
    },
    "settings.persistence.pausedTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic actions paused"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wstrzymano działania automatyczne"}}
      }
    },
    "settings.persistence.pausedHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved action history or permissions could not be read or saved. Existing records and your policy have been kept. Read-only checks remain available; restore the affected records before resuming actions that need them."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wystąpił problem z odczytem lub zapisem historii działań albo uprawnień. Dotychczasowe dane i zasady zostały zachowane. Nadal możesz uruchamiać kontrole tylko do odczytu. Przywróć potrzebne dane przed wznowieniem działań."}}
      }
    },
    "settings.persistence.actionBlocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved action history or permissions are unavailable. Restore the affected records before trying this action."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zapisana historia działań lub uprawnienia są niedostępne. Przywróć te dane i spróbuj ponownie."}}
      }
    },
    "settings.automation.workflow.reviewWaitingHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track review waiting locally. This event never starts an agent or creates GitLab comments."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Rejestruj lokalnie oczekiwanie na przegląd. To zdarzenie dotyczy tylko śledzenia stanu, bez uruchamiania agenta i tworzenia komentarzy w GitLabie."}}
      }
    },
    "settings.automation.profilePermissionsHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a profile, then adjust permissions. Reset restores only that setting to the chosen profile."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wybierz profil, a potem dostosuj uprawnienia. Przywrócenie wartości domyślnej zmienia tylko dane ustawienie na wartość z wybranego profilu."}}
      }
    },
    "settings.automation.scope.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automate merge requests"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatyzuj obsługę merge requestów"}}
      }
    },
    "settings.automation.scope.all": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All eligible MRs"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wszystkie kwalifikujące się MR"}}
      }
    },
    "settings.automation.scope.selected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected repositories and MRs"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wybrane repozytoria i MR"}}
      }
    },
    "settings.automation.scope.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automate all eligible merge requests or only selected repositories and MRs. An MR setting overrides its repository."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatyzuj obsługę wszystkich kwalifikujących się merge requestów lub tylko wybranych repozytoriów i MR. Ustawienie MR ma pierwszeństwo przed ustawieniem repozytorium."}}
      }
    },
    "settings.automation.page.advanced": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zaawansowane"}}
      }
    },
    "settings.automation.keep.mac.awake": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Mac awake during agent tasks on external power"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zapobiegaj uśpieniu Maca podczas zadań agenta przy zasilaniu zewnętrznym"}}
      }
    },
    "settings.automation.keep.mac.awake.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The display can sleep. Your Mac follows its usual sleep settings on battery and between agent tasks."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Ekran może się wyłączyć. Na baterii i między zadaniami agenta Mac stosuje zwykłe ustawienia uśpienia."}}
      }
    },
    "settings.automation.workspace.choose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Folder…"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wybierz folder…"}}
      }
    },
    "settings.automation.workspace.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting folder for coding agent conversations you open in Terminal. Automated tasks use separate workspaces for each run."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Folder startowy rozmów z asystentem programistycznym otwieranych w Terminalu. Każde automatyczne uruchomienie korzysta z osobnego obszaru roboczego."}}
      }
    },
    "settings.automation.todo.customize": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customize task title and instructions"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Dostosuj tytuł i instrukcje zadania"}}
      }
    },
    "settings.automation.autoReReview.toggle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically request re-review"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Automatycznie proś o ponowny przegląd"}}
      }
    },
    "settings.automation.autoReReview.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After feedback is verified as addressed and replies are published, ask reviewers who haven’t accepted it to review again. GitLab may reset an earlier approval."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Po zweryfikowaniu, że uwagi zostały uwzględnione, i opublikowaniu odpowiedzi poproś o ponowny przegląd osoby, które jeszcze ich nie zaakceptowały. GitLab może wycofać wcześniejsze zatwierdzenie."}}
      }
    },
    "settings.automation.reviewModel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coding model"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Model asystenta"}}
      }
    },
    "settings.automation.reviewThinking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coding reasoning"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Poziom rozumowania asystenta"}}
      }
    },
    "settings.automation.reviewModelHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used by the selected coding agent for MR reviews, feedback fixes, pipeline fixes and conflicts. Lightweight checks use the separate verification model."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wybrany asystent używa tego modelu do przeglądów MR, poprawek po uwagach, napraw pipeline’ów i rozwiązywania konfliktów. Krótkie kontrole korzystają z osobnego modelu weryfikacji."}}
      }
    },
