    "settings.automation.authorFeedback.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs when someone submits a review or addresses you in a comment on an open merge request you authored."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Uruchamia zadanie, gdy ktoś prześle przegląd lub zwróci się do Ciebie w komentarzu do Twojego otwartego merge requesta."}}
      }
    },
    "settings.automation.authoredMergeRequests.polling": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your open merge requests are checked in the background at the refresh interval set in General. Open the main window to review their status and actions."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Twoje otwarte merge requesty są sprawdzane w tle z częstotliwością ustawioną w zakładce Ogólne. W głównym oknie znajdziesz ich stan i dostępne działania."}}
      }
    },
    "settings.automation.authoredMergeRequests.projectsHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave repository restrictions blank to cover all eligible MRs in active Scope. Enter exact project paths separated by commas to narrow the permission."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Puste pole obejmuje wszystkie kwalifikujące się MR w aktywnym zakresie. Aby zawęzić uprawnienie, wpisz dokładne ścieżki projektów oddzielone przecinkami."}}
      }
    },
    "settings.automation.autoMerge.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merge your eligible MRs after approvals, resolved discussions, a passing pipeline and verified reviewer expectations. All required dependencies must be merged first. Stacked MRs wait for a reviewed target update; MergeTether never merges a child into its parent MR branch or retargets it automatically. Unavailable dependency checks keep merging on hold. The project must enforce approvals and resolved discussions."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Scalaj kwalifikujące się własne MR po uzyskaniu zatwierdzeń, zamknięciu dyskusji, pomyślnym pipeline’ie i zweryfikowaniu oczekiwań recenzentów. Najpierw muszą zostać scalone wszystkie wymagane zależności. Zależne MR czekają na sprawdzenie zmiany gałęzi docelowej. MergeTether wstrzymuje scalanie do gałęzi nadrzędnego MR i pozostawia zmianę gałęzi docelowej użytkownikowi. Gdy sprawdzenie zależności jest niedostępne, scalanie czeka. Projekt musi wymagać zatwierdzeń i zamkniętych dyskusji."}}
      }
    },
    "settings.automation.autoMerge.projects": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic merge repositories (optional)"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Repozytoria z automatycznym scalaniem (opcjonalnie)"}}
      }
    },
    "settings.automation.autoMerge.toggle": {
