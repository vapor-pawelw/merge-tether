            "value": "Automatically run reviews, feedback fixes, CI workflows, publication of all eligible comments, approvals, thread resolution and eligible merges. Verified follow-up and conflict fixes may be pushed within active Scope. Project and verification checks still apply."
          }
        }
      }
    },
    "settings.automation.package.checkpointsHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run reviews, diagnoses and local fix proposals automatically. Publish checked replies to likely AI-assisted comments; other comments await confirmation. Pushes, approvals, merges and thread resolution are manual. Readiness verification and re-review requests stay on."
          }
        }
      }
    },
    "settings.automation.package.manualHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor MRs and manage actions manually. Automatic runs, verification and remote actions are off. You can explicitly start a coding-agent review when a signed-in CLI is available."
          }
        }
      }
    },
    "settings.automation.publication.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
