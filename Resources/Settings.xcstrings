    "settings.automation.assistant.toolsHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI tasks have full tool access. This project permission is separate from the conflict-push switch. Leave its repository list blank for all active Scope, or list exact paths to narrow it."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zadania CLI mają pełny dostęp do narzędzi. To uprawnienie projektowe działa niezależnie od przełącznika wysyłania poprawek konfliktów. Pusta lista obejmuje cały aktywny zakres. Możesz go zawęzić, wpisując dokładne ścieżki repozytoriów."}}
      }
    },
    "settings.automation.authorFeedback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback on my MR"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Uwagi do mojego MR"}}
      }
