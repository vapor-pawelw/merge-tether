      }
    },
    "remote.relay.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone access is unavailable in this build. Deploy your own relay and rebuild both apps with its HTTPS origin. The Mac works without phone access."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp z telefonu jest niedostępny w tym buildzie. Wdróż własny relay i zbuduj obie aplikacje z jego adresem HTTPS. Mac działa bez dostępu z telefonu."
          }
        }
      }
    },
    "remote.relay.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build has an invalid relay origin. Rebuild both apps with an HTTPS origin without credentials, path, query or fragment."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten build ma nieprawidłowy adres relaya. Zbuduj obie aplikacje z adresem HTTPS bez danych logowania, ścieżki, zapytania i fragmentu."
          }
        }
      }
    },
    "remote.relay.mismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pairing uses another relay. Use matching builds or explicitly pair with the relay configured here. Existing trust remains unchanged until you confirm a new matching pairing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To parowanie używa innego relaya. Użyj zgodnych buildów lub jawnie sparuj urządzenia z relayem skonfigurowanym tutaj. Dotychczasowe zaufanie pozostaje bez zmian do potwierdzenia nowego, zgodnego parowania."
          }
        }
      }
    }
  },
  "version": "1.0"
}
