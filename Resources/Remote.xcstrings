          "stringUnit": {
            "state": "translated",
            "value": "Mac musi pozostać włączony. Zeskanuj prywatny kod w aplikacji iOS. Osoba z kodem może przeglądać skrzynkę i wykonywać jej akcje."
          }
        }
      }
    },
    "remote.relayHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your own relay deployment. Enter its private runtime invitation; the address comes from this build. No shared relay is provided."
