          "stringUnit": {
            "state": "translated",
            "value": "Operator: the person or organization controlling this address. Confirm this is your deployment."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operator: osoba lub organizacja zarządzająca tym adresem. Upewnij się, że to Twoja instancja."
          }
