    },
    "remote.unavailableHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing is saved. Check that your Mac is awake, MergeTether is running and both devices have internet access. We keep trying in the background while this app is open."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Parowanie jest zapisane. Sprawdź, czy Mac jest wybudzony, MergeTether działa i oba urządzenia mają internet. Gdy ta aplikacja jest otwarta, nadal próbujemy się połączyć."
          }
        }
      }
    },
