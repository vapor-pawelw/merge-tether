    "remote.connectingHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pairing is saved. Waiting for a fresh board from your Mac. Keep MergeTether open on an awake, connected Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Parowanie jest zapisane. Czekamy na aktualną tablicę z Maca. MergeTether musi być otwarty, a Mac wybudzony i połączony z siecią."
          }
        }
      }
    },
    "remote.unavailable": {
      "extractionState": "manual",
      "localizations": {
