    "remote.macHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac must stay awake. Scan this private code in the iOS app. Anyone with it can view your inbox and use its actions."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac musi pozostać włączony. Zeskanuj prywatny kod w aplikacji iOS. Osoba z kodem może przeglądać skrzynkę i wykonywać jej akcje."
          }
        }
      }
    },
    "remote.relayHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-time Mac setup. Deploy the free relay, then enter its address and invitation. The phone only scans a code."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednorazowe ustawienie na Macu. Wdróż darmowy relay i podaj jego adres oraz zaproszenie. Telefon skanuje tylko kod."
          }
        }
      }
    },
