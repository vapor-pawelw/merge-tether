{
  "sourceLanguage": "en",
  "strings": {
    "title": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Agent task time limit" } }, "pl": {"stringUnit": {"state": "translated", "value": "Limit czasu zadania agenta"}} } },
    "defaultLimit": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Default limit" } }, "pl": {"stringUnit": {"state": "translated", "value": "Limit domyślny"}} } },
    "minutes": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "minutes" } }, "pl": {"stringUnit": {"state": "translated", "value": "min"}} } },
    "savedRepository": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Saved repository" } }, "pl": {"stringUnit": {"state": "translated", "value": "Zapisane repozytorium"}} } },
    "noRepositories": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Add a merge request to your board or Scope to choose its repository here." } }, "pl": {"stringUnit": {"state": "translated", "value": "Dodaj merge request do tablicy lub zakresu, aby wybrać tutaj jego repozytorium."}} } },
    "addOverride": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Add project override" } }, "pl": {"stringUnit": {"state": "translated", "value": "Dodaj ustawienie dla projektu"}} } },
    "removeOverride": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Remove project override" } }, "pl": {"stringUnit": {"state": "translated", "value": "Usuń ustawienie dla projektu"}} } },
    "help": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Codex and Claude coding workers allow 30 minutes by default. Choose 1–1,440 minutes to allow longer builds and tests. This limit covers the whole worker process." } }, "pl": {"stringUnit": {"state": "translated", "value": "Agenci programistyczni Codex i Claude mają domyślnie 30 minut. Wybierz od 1 do 1440 minut, aby umożliwić dłuższe kompilacje i testy. Limit obejmuje cały proces agenta."}} } },
    "overridesHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Choose a repository from your current board or managed list. Each override applies to that exact project on the displayed host. Profiles and restoring Custom preserve these limits." } }, "pl": {"stringUnit": {"state": "translated", "value": "Wybierz repozytorium z tablicy lub listy zarządzanych. Każde ustawienie dotyczy dokładnie wybranego projektu na wskazanym hoście. Wybór profilu lub przywrócenie profilu własnego zachowuje limity."}} } },
    "invalidOverrides": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "A saved timeout override has an invalid or repeated repository. Remove it and select the repository again before applying changes." } }, "pl": {"stringUnit": {"state": "translated", "value": "Zapisany limit dotyczy nieprawidłowego lub powtórzonego repozytorium. Usuń wpis i ponownie wybierz repozytorium przed zastosowaniem zmian."}} } },
    "runHelp": { "extractionState": "manual", "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Each run keeps its saved timeout. Apply Changes follows the existing automation policy behavior and cancels active workers. An expired task fails and requires an explicit retry; it is never restarted automatically." } }, "pl": {"stringUnit": {"state": "translated", "value": "Każde uruchomienie zachowuje swój zapisany limit. „Zastosuj zmiany” działa zgodnie z zasadami automatyzacji i anuluje aktywne zadania. Po upływie limitu zadanie kończy się niepowodzeniem, a ponowienie wymaga ręcznego działania."}} } }
  },
  "version": "1.0"
}
