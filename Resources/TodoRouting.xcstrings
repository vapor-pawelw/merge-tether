{
  "sourceLanguage": "en",
  "strings": {
    "todoRouting.assistantUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected coding agent CLI is unavailable or not signed in. Check the agent setup before retrying."
          }
        }
      }
    },
    "todoRouting.followUpNeedsEvidence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The worker finished, but current feedback evidence is missing or work remains. Check the latest feedback verification; a run result alone does not prove completion."
          }
        }
      }
    },
    "todoRouting.missingRun": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The associated run is unavailable. Check the merge request before trying again."
          }
        }
      }
    },
    "todoRouting.needsRecheck": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action needs a fresh check against the current merge request."
          }
        }
      }
    },
    "todoRouting.previousAttempt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This event has an earlier attempt. Check its result before starting another run."
          }
        }
      }
    },
    "todoRouting.shellUnsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action uses a configured shell command. Run it explicitly outside automatic MR handling or switch the action to a coding agent CLI."
          }
        }
      }
    },
