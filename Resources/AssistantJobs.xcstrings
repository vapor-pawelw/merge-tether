{
  "sourceLanguage": "en",
  "strings": {
    "assistant.jobs.read.only.review": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full review"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Pełny przegląd"}}
      }
    },
    "assistant.jobs.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent runs"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Uruchomienia agentów"}}
      }
    },
    "assistant.jobs.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A completed run may still have pending drafts or decisions. Open the MR to review them."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zakończone uruchomienie może nadal mieć oczekujące szkice lub decyzje. Otwórz MR, aby je przejrzeć."}}
      }
    },
    "assistant.jobs.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No agent runs for this selection."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Brak uruchomień agentów dla tego wyboru."}}
      }
    },
    "assistant.jobs.audit.heading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitLab changes observed during this run. Check the merge request to confirm who made them."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zaobserwowane zmiany w GitLabie podczas tego uruchomienia. Sprawdź merge request, aby potwierdzić, kto je wprowadził."}}
      }
    },
    "assistant.jobs.audit.published.comment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New published comment from your account"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nowy opublikowany komentarz z Twojego konta"}}
      }
    },
    "assistant.jobs.audit.approval": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New approval from your account"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nowe zatwierdzenie z Twojego konta"}}
      }
    },
    "assistant.jobs.audit.resolved.discussion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discussion resolved by your account outside this task’s permissions"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Dyskusja rozwiązana przez Twoje konto poza uprawnieniami tego zadania"}}
      }
    },
    "assistant.jobs.audit.source.head": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source commit changed while push was disabled for this run"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Commit źródłowy zmienił się, gdy wysyłanie zmian było wyłączone dla tego uruchomienia"}}
      }
    },
    "assistant.jobs.transcript": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show run transcript"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Pokaż transkrypcję uruchomienia"}}
      }
    },
    "assistant.jobs.stop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zatrzymaj"}}
      }
    },
    "assistant.jobs.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run again"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Uruchom ponownie"}}
      }
    },
    "assistant.jobs.copy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy instructions"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Kopiuj instrukcje"}}
      }
    },
    "assistant.jobs.statusUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status unavailable"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Stan niedostępny"}}
      }
    },
    "assistant.jobs.queued": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queued"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "W kolejce"}}
      }
    },
    "assistant.jobs.running": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "W trakcie"}}
      }
    },
    "assistant.jobs.succeeded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run completed"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Uruchomienie zakończone"}}
      }
    },
    "assistant.jobs.blocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs attention"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Wymaga uwagi"}}
      }
    },
    "assistant.jobs.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Niepowodzenie"}}
      }
    },
    "assistant.jobs.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zatrzymano"}}
      }
    },
    "assistant.jobs.interrupted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrupted"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Przerwano"}}
      }
    },
    "assistant.jobs.actionFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not start this run. Refresh the MR and check the selected CLI in Settings."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Nie udało się rozpocząć. Odśwież MR i sprawdź wybrane CLI w Ustawieniach."}}
      }
    },
    "assistant.jobs.files": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show run files"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Pokaż pliki uruchomienia"}}
      }
    },
    "assistant.jobs.prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show run prompt"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Pokaż prompt uruchomienia"}}
      }
    },
    "assistant.jobs.interruptedHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work stopped. Some commits, pushes or replies may already exist. Run files are retained; retry checks the current MR and existing actions before continuing."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Praca została zatrzymana. Część commitów, wysyłek lub odpowiedzi mogła już zostać wykonana. Pliki uruchomienia zachowano; ponowienie sprawdza bieżący MR i istniejące działania przed kontynuacją."}}
      }
    },
    "assistant.jobs.error.cliUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The coding agent is unavailable. Check Settings → General → Coding agent, then try again."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Asystent jest niedostępny. Sprawdź Ustawienia → Ogólne → Asystent programistyczny i spróbuj ponownie."
          }
        }
      }
    },
    "assistant.jobs.error.wrongAccount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The signed-in GitLab account or host has changed. Restore the account used for this run, then try again."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Zalogowane konto GitLaba lub host uległy zmianie. Przywróć konto użyte dla tego uruchomienia i spróbuj ponownie."}}
      }
    },
    "assistant.jobs.error.inactiveMergeRequest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This merge request or its pipeline is no longer eligible for this task. Refresh the MR before starting a new run."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Ten merge request lub jego pipeline nie kwalifikują się już do tego zadania. Odśwież MR przed rozpoczęciem nowego uruchomienia."}}
      }
    },
    "assistant.jobs.error.missingResult": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent finished without a task result. Inspect the run transcript before trying again."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Agent zakończył pracę bez wyniku zadania. Przejrzyj transkrypcję przed ponowną próbą."}}
      }
    },
    "assistant.jobs.error.disabledPermission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task is blocked by the current automation settings. Check Settings → Automation and this MR’s automation rules before trying again."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "To zadanie blokują bieżące ustawienia automatyzacji. Przed ponowną próbą sprawdź Ustawienia → Automatyzacja oraz reguły automatyzacji tego MR."}}
      }
    },
    "assistant.jobs.error.headChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The merge request has new commits. Refresh it and start a new run for the current commit."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Merge request zawiera nowe commity. Odśwież go i rozpocznij nowe uruchomienie dla bieżącego commitu."}}
      }
    },
    "assistant.jobs.error.contextUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current merge request state or source commit is unavailable. Automatic work will wait for complete GitLab evidence."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Bieżący stan merge requestu lub commit źródłowy są niedostępne. Automatyczna praca poczeka na kompletne dane z GitLaba."}}
      }
    }
  },
  "version": "1.0"
}
