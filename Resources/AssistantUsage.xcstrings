      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "USD estimates do not measure subscription payments. Codex uses standard short-context API rates from 8 Nov 2026, excluding cache-write premiums, tools and tier/context adjustments. Claude uses the CLI estimate."
