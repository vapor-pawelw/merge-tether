      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One prompt issued by MergeTether per CLI invocation. Retries count separately; cached checks add no request. Internal model turns and tool calls are not counted."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "MergeTether wysyła jedno żądanie na uruchomienie CLI. Ponowienia liczą się osobno, a kontrole korzystające z pamięci podręcznej nie dodają żądania. Wewnętrzne kroki modelu i wywołania narzędzi są pomijane."}}
      }
