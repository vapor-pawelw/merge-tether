    "assistantUsageEstimateExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How estimates work"
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Jak powstają szacunki"}}
      }
    },
    "assistantUsageEstimateHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "USD estimates do not measure subscription payments. Codex uses standard short-context API rates from 8 Nov 2026, excluding cache-write premiums, tools and tier/context adjustments. Claude uses the CLI estimate."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Szacunki w USD nie uwzględniają opłat abonamentowych. Dla Codexa stosuje się standardowe stawki API dla krótkiego kontekstu z 8 listopada 2026 r., bez dopłat za zapis w pamięci podręcznej, narzędzi i korekt zależnych od poziomu usługi lub kontekstu. Dla Claude’a używany jest szacunek CLI."}}
      }
    },
    "assistantUsageScopeHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only runs started by MergeTether are recorded. Separately launched nested CLIs may not be included."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Rejestrowane są tylko uruchomienia rozpoczęte przez MergeTether. Osobno uruchomione, zagnieżdżone sesje CLI mogą zostać pominięte."}}
      }
    },
    "assistantUsageUnknownHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown or partial runs may add cost beyond the displayed subtotal. Cached input is included in input tokens."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Uruchomienia o nieznanych lub częściowych kosztach mogą zwiększyć wyświetloną sumę częściową. Tokeny wejściowe obejmują tokeny z pamięci podręcznej."}}
      }
    },
