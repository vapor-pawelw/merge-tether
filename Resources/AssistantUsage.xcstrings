    "assistantUsageChartHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hover over a bar for the overall estimate and each CLI. Bars show known estimates; orange markers indicate unknown or partial usage. Missing costs are not plotted as zero. Runs are grouped by start time (UTC)."
          }
        },
        "pl": {"stringUnit": {"state": "translated", "value": "Najedź na słupek, aby zobaczyć łączny szacunek i wynik dla każdego CLI. Słupki obejmują znane szacunki, a pomarańczowe znaczniki pokazują nieznane lub częściowe użycie. Brakujące koszty są pomijane na wykresie. Uruchomienia są grupowane według czasu rozpoczęcia (UTC)."}}
      }
    },
