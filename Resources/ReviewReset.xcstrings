    "reviewResetHelpAuthored": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget earlier feedback checks and verify every comment against the current merge request from scratch. Later checks then cover only new or changed comments again."
          }
        }
      }
    },
    "reviewResetHelpReviewed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore earlier review passes and run a full review of the whole current merge request. Later re-reviews then cover only what changed again."
          }
        }
      }
    }
